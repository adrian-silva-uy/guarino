using BenchmarkDotNet.Attributes;
using GuarinoApp.Application.Common.Interfaces;
using GuarinoApp.Application.Settings;
using GuarinoApp.Domain.Entities;
using GuarinoApp.Infrastructure.Services;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;
using Moq;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.VSDiagnostics;

namespace GuarinoApp.Infrastructure.Benchmarks
{
    [CPUUsageDiagnoser]
    public class OpenMeteoClimateServiceBenchmark
    {
        private OpenMeteoClimateService _service;
        private Mock<IApplicationDbContext> _mockContext;
        private Mock<HttpMessageHandler> _mockHttpHandler;
        private HttpClient _httpClient;
        private ILogger<OpenMeteoClimateService> _logger;
        private IOptions<ClimateRiskSettings> _settings;
        [GlobalSetup]
        public void Setup()
        {
            // Configurar logger
            var loggerFactory = LoggerFactory.Create(builder => builder.AddConsole());
            _logger = loggerFactory.CreateLogger<OpenMeteoClimateService>();
            // Configurar settings
            var climateSettings = new ClimateRiskSettings
            {
                RegionalContext = "Test Region",
                Thresholds = new ThresholdsConfig
                {
                    HeladaTempMin = 0,
                    HeladaTempSevera = -3,
                    LluviaExcesivaMm = 50,
                    LluviaMuyExcesivaMm = 100,
                    VientoFuerteKmh = 50,
                    VientoFuerteKmhCritico = 80,
                    CalorExtremoTempMax = 38
                },
                ImpactEstimates = new ImpactEstimatesConfig
                {
                    HeladaPerdida = 15,
                    HeladaSeveraPerdida = 45,
                    LluviaExcesivaPerdida = 20,
                    LluviaMuyExcesivaPerdida = 50,
                    VientoFuertePerdida = 10,
                    CalorExtremoPerdida = 25
                }
            };
            _settings = Options.Create(climateSettings);
            // Configurar mock HTTP
            _mockHttpHandler = new Mock<HttpMessageHandler>();
            _httpClient = new HttpClient(_mockHttpHandler.Object);
            // Mock response data
            var mockResponse = new OpenMeteoResponse
            {
                Hourly = new HourlyData
                {
                    Time = Enumerable.Range(0, 72).Select(i => DateTime.Now.AddHours(-72 + i)).ToList(),
                    Temperature_2m = Enumerable.Range(0, 72).Select(i => 20.0 + (i % 10)).Cast<double?>().ToList(),
                    Precipitation = Enumerable.Range(0, 72).Select(i => (i % 5) * 10.0).Cast<double?>().ToList(),
                    Wind_speed_10m = Enumerable.Range(0, 72).Select(i => 10.0 + (i % 20)).Cast<double?>().ToList()
                }
            };
            var responseJson = JsonSerializer.Serialize(mockResponse);
            var responseContent = new StringContent(responseJson, System.Text.Encoding.UTF8, "application/json");
            _mockHttpHandler.Protected().Setup<Task<HttpResponseMessage>>("SendAsync", ItExpr.IsAny<HttpRequestMessage>(), ItExpr.IsAny<CancellationToken>()).ReturnsAsync(new HttpResponseMessage { StatusCode = HttpStatusCode.OK, Content = responseContent });
            // Configurar mock DbContext
            _mockContext = new Mock<IApplicationDbContext>();
            var lotes = new List<Lote>
            {
                new Lote
                {
                    Id = 1,
                    Codigo = "L001",
                    Latitude = -31.4,
                    Longitude = -55.5,
                    ProductorId = 1
                },
                new Lote
                {
                    Id = 2,
                    Codigo = "L002",
                    Latitude = -31.5,
                    Longitude = -55.6,
                    ProductorId = 1
                },
                new Lote
                {
                    Id = 3,
                    Codigo = "L003",
                    Latitude = -31.6,
                    Longitude = -55.7,
                    ProductorId = 2
                }
            };
            var mockLotesDbSet = MockDbSet(lotes);
            var mockEventosDbSet = MockDbSet(new List<EventoClimatico>());
            _mockContext.Setup(x => x.Lotes).Returns(mockLotesDbSet.Object);
            _mockContext.Setup(x => x.EventosClimaticos).Returns(mockEventosDbSet.Object);
            _mockContext.Setup(x => x.SaveChangesAsync(It.IsAny<CancellationToken>())).ReturnsAsync(0);
            _service = new OpenMeteoClimateService(_httpClient, _mockContext.Object, _logger, _settings);
        }

        [Benchmark]
        public async Task DetectarYRegistrarEventos()
        {
            await _service.DetectarYRegistrarEventosAsync(CancellationToken.None);
        }

        private static Mock<DbSet<T>> MockDbSet<T>(List<T> data)
            where T : class
        {
            var queryableData = data.AsQueryable();
            var mockDbSet = new Mock<DbSet<T>>();
            mockDbSet.As<IQueryable<T>>().Setup(m => m.Provider).Returns(queryableData.Provider);
            mockDbSet.As<IQueryable<T>>().Setup(m => m.Expression).Returns(queryableData.Expression);
            mockDbSet.As<IQueryable<T>>().Setup(m => m.ElementType).Returns(queryableData.ElementType);
            mockDbSet.As<IQueryable<T>>().Setup(m => m.GetEnumerator()).Returns(queryableData.GetEnumerator());
            mockDbSet.Setup(x => x.AddRangeAsync(It.IsAny<IEnumerable<T>>(), It.IsAny<CancellationToken>())).Returns(Task.CompletedTask);
            return mockDbSet;
        }
    }
}