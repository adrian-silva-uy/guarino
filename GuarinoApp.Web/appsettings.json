{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=.;Database=GuarinoApp;Trusted_Connection=true;Encrypt=false;"
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "Security": {
        "EnableFallbackIdentity": true,
        "DefaultRole": "Gerencia",
        "UserRoles": {
            "ADRIA": "Gerencia"
        }
    },
    "Ollama": {
        "Enabled": true,
        "Url": "http://localhost:11434",
        "Model": "llama3.2:1b",
        "NumCtx": 1024,
        "TimeoutSeconds": 120,
        "TopK": 40,
        "TopP": 0.9,
        "Temperature": 0.7
    },
    "ClimateRisk": {
        "RegionalContext": "Salto, Paysandú, Uruguay",
        "OpenMeteoApiUrl": "https://api.open-meteo.com/v1/forecast",
        "ApiTimeoutSeconds": 10,
        "MaxParallelRequests": 5,
        "Thresholds": {
            "HeladaTempMin": 0,
            "HeladaTempSevera": -3,
            "LluviaExcesivaMm": 50,
            "LluviaMuyExcesivaMm": 100,
            "VientoFuerteKmh": 50,
            "VientoFuerteKmhCritico": 80,
            "CalorExtremoTempMax": 38
        },
        "ImpactEstimates": {
            "HeladaPerdida": 15.0,
            "HeladaSeveraPerdida": 45.0,
            "LluviaExcesivaPerdida": 20.0,
            "LluviaMuyExcesivaPerdida": 50.0,
            "VientoFuertePerdida": 10.0,
            "CalorExtremoPerdida": 25.0
        }
    }
}
