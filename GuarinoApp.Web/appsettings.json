{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=.;Database=GuarinoApp;Trusted_Connection=true;Encrypt=false;"
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "Security": {
        "EnableFallbackIdentity": true,
        "DefaultRole": "Gerencia",
        "UserRoles": {
            "ADRIA": "Admin"
        }
    },
    "Auth": {
        "Mode": "Local",
        "AllowRegistration": true,
        "TokenValidityHours": 12,
        "DefaultRole": "Operador"
    },
    "Ollama": {
        "Enabled": true,
        "Url": "http://localhost:11434",
        "Model": "llama3.2:1b",
        "NumCtx": 1024,
        "TimeoutSeconds": 120,
        "TopK": 40,
        "TopP": 0.9,
        "Temperature": 0.7,
        "Sanacion": {
            "Habilitada": true,
            "IntervaloSegundos": 60,
            "MaxReiniciosPorHora": 3,
            "GestionarProceso": true,
            "RutaEjecutable": "",
            "TimeoutVerificacionSegundos": 90
        }
    },
    "IaWeb": {
        "Habilitada": true,
        "UrlBase": "https://api.groq.com/openai/v1",
        "Modelo": "openai/gpt-oss-120b",
        "ApiKey": "",
        "TimeoutSegundos": 45,
        "ConsultasWebSimultaneas": 4,
        "EsperaLocalSegundos": 12
    },
    "Notificaciones": {
        "Habilitadas": true,
        "EmailAdmin": "adriansil@hotmail.com",
        "IntervaloMinutos": 15,
        "Asunto": "Guarino App - logs del día : "
    },
    "Mcp": {
        "Enabled": true,
        "TimeoutSeconds": 45,
        "CacheSeconds": 300,
        "MaxCallsPerQuery": 2,
        "MaxCharsPerResult": 700,
        "Servers": [
            { "Name": "DeepWiki", "Url": "https://mcp.deepwiki.com/mcp", "Token": "", "Enabled": true },
            { "Name": "context7", "Url": "https://mcp.context7.com/mcp", "Token": "", "Enabled": true },
            { "Name": "alphavantage", "Url": "https://mcp.alphavantage.co/mcp", "Token": "", "Enabled": false }
        ],
        "Rules": [
            {
                "Server": "deepwiki",
                "Tool": "ask_wiki_question",
                "Triggers": [ "documentación del repositorio", "pregunta al repositorio", "deepwiki", "mudblazor" ],
                "Args": { "repoName": "MudBlazor/MudBlazor", "question": "{query}" }
            },
            {
                "Server": "context7",
                "Tool": "query-docs",
                "Triggers": [ "asp.net", "asp.net core", "context7" ],
                "Args": { "libraryId": "/dotnet/aspnetcore", "query": "{query}" }
            }
        ]
    },
    "ClimateRisk": {
        "RegionalContext": "Salto, Paysandú, Uruguay",
        "OpenMeteoApiUrl": "https://api.open-meteo.com/v1/forecast",
        "ApiTimeoutSeconds": 10,
        "MaxParallelRequests": 5,
        "Thresholds": {
            "HeladaTempMin": 0,
            "HeladaTempSevera": -3,
            "LluviaExcesivaMm": 50,
            "LluviaMuyExcesivaMm": 100,
            "VientoFuerteKmh": 50,
            "VientoFuerteKmhCritico": 80,
            "CalorExtremoTempMax": 38,
            "GranizoWeatherCodeMin": 96,
            "GranizoWeatherCodeSevera": 99
        },
        "ImpactEstimates": {
            "HeladaPerdida": 15.0,
            "HeladaSeveraPerdida": 45.0,
            "LluviaExcesivaPerdida": 20.0,
            "LluviaMuyExcesivaPerdida": 50.0,
            "VientoFuertePerdida": 10.0,
            "CalorExtremoPerdida": 25.0,
            "GranizoPerdida": 35.0,
            "GranizoSeveraPerdida": 75.0
        }
    }
}
