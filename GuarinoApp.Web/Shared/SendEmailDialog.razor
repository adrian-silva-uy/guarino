@using MudBlazor
@using System.Net.Mail
@using GuarinoApp.Application.Common

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value ="Email"
                      Label="Destinatario"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Immediate="true"
                      Validation="@(new Func<string, string>(ValidateEmail))" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Enviar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Email { get; set; } = string.Empty;

    private string ValidateEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "El email es obligatorio";
        }

        try
        {
            var address = new MailAddress(email);
            return string.Empty;
        }
        catch (FormatException)
        {
            return "Email invalido";
        }
    }

    private string _error = string.Empty;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        // Sanitiza antes de validar: caracteres de control, saltos de línea
        // u otros textos pegados no viajan hacia el campo de correo.
        Email = SanitizadorTexto.UnaLinea(Email, 254);

        _error = ValidateEmail(Email);
        if (string.IsNullOrEmpty(_error))
        {
            MudDialog.Close(DialogResult.Ok(Email));
        }
    }
}
