@using System.Security.Claims
@using GuarinoApp.Application.Common
@inject AuthenticationStateProvider AuthProvider
@inject IAuthenticationStateNotifier AuthNotifier
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudText Typo="Typo.body2" Class="d-inline-flex align-items-center">
    @if (_isAuthenticated)
    {
        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-1" Size="Size.Small" />
        <span>@_displayName</span>
        @if (_isAdmin)
        {
            <MudChip Color="Color.Error" Size="Size.Small" Class="ml-2">Admin</MudChip>
        }
        else if (_isGerencia)
        {
            <MudChip Color="Color.Primary" Size="Size.Small" Class="ml-2">Gerencia</MudChip>
        }
        else if (_isContador)
        {
            <MudChip Color="Color.Success" Size="Size.Small" Class="ml-2">Contador</MudChip>
        }
        else if (_isOperador)
        {
            <MudChip Color="Color.Warning" Size="Size.Small" Class="ml-2">Operador</MudChip>
        }
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Title="Cerrar sesión"
                       Size="Size.Small"
                       Color="Color.Inherit"
                       Class="ml-1"
                       OnClick="LogoutAsync" />
    }
</MudText>

@code {
    private bool _isAuthenticated = false;
    private string? _userName = null;
    private string? _fullName = null;
    private bool _isAdmin = false;
    private bool _isGerencia = false;
    private bool _isContador = false;
    private bool _isOperador = false;

    private string? _displayName => string.IsNullOrWhiteSpace(_fullName) ? _userName : _fullName;

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        Apply(authState.User);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            var authState = await task;
            Apply(authState.User);
            StateHasChanged();
        });
    }

    private void Apply(ClaimsPrincipal user)
    {
        _isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        _userName = user.Identity?.Name;
        _fullName = user.Claims.FirstOrDefault(c => c.Type == AuthClaims.FullName)?.Value;

        _isAdmin = _isAuthenticated && user.IsInRole(RoleNames.Admin);
        _isGerencia = _isAuthenticated && user.IsInRole(RoleNames.Gerencia);
        _isContador = _isAuthenticated && user.IsInRole(RoleNames.Contador);
        _isOperador = _isAuthenticated && user.IsInRole(RoleNames.Operador);
    }

    private async Task LogoutAsync()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", AuthStorage.TokenKey);
        Navigation.NavigateTo("/login", replace: true);
        AuthNotifier.NotifyChanged();
    }
}
