@page "/proyeccion-volcados"
@attribute [Authorize(Roles = RoleNames.TodosAutorizacion)]
@using MediatR
@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using GuarinoApp.Application.Modules.Proyeccion.Queries.GetProyeccion
@using GuarinoApp.Application.Modules.Proyeccion.Dtos
@using GuarinoApp.Application.Common.Interfaces
@using System.Globalization
@using GuarinoApp.Web.Shared
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject IPromptProvider PromptProvider

<MudText Typo="Typo.h4" GutterBottom="true">📈 Proyección de Volcados</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Análisis de tendencia, estacionalidad y proyección con IA</MudText>

<MudCard>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTooltip Text="Recalcula la tendencia y proyección de volcados con los datos nuevos.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData" Disabled="@_loading" FullWidth="true">
                    @(_loading ? "Cargando..." : "Actualizar")
                </MudButton>
                </MudTooltip>
            </MudItem>
        </MudGrid>

        @if (_data.Any())
        {
            <!-- Gráfico de proyección -->
            <MudText Typo="Typo.h6" GutterBottom="true">Evolución y Proyección (Kgs)</MudText>
            <InteractiveChart @key="_chartKey" Series="_chartSeries" Labels="_chartLabels" Type="InteractiveChartType.Line" Height="350px" />

            <!-- Tarjetas de resumen -->
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="0" Style="border-left: 4px solid #3d6fb0;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">Proyección Total</MudText>
                            <MudText Typo="Typo.h5">@_proyectados.Sum(x => x.KgsProyectados).ToString("N0")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">Para los próximos @_proyectados.Count meses</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="0" Style="border-left: 4px solid #4caf50;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">Promedio Mensual</MudText>
                            <MudText Typo="Typo.h5">@(_proyectados.Any() ? _proyectados.Average(x => x.KgsProyectados).ToString("N0") : "-")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">Proyección mensual</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="0" Style="border-left: 4px solid #ff9800;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">Tendencia</MudText>
                            <MudText Typo="Typo.h5">@(_proyectados.Any() ? $"{_tendenciaPromedio:F1}%" : "-")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Warning">Variación estimada</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="0" Style="border-left: 4px solid #f44336;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">Mes Pico Proyectado</MudText>
                            <MudText Typo="Typo.h5">@(_mesPico?.Periodo ?? "N/A")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Error">Mayor volumen estimado</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Tabla detallada -->
            <MudTable Items="@_data" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="mt-4">
                <HeaderContent>
                    <MudTh>Periodo</MudTh>
                    <MudTh Numeric="true">Histórico (Kgs)</MudTh>
                    <MudTh Numeric="true">Proyectado (Kgs)</MudTh>
                    <MudTh Numeric="true">Tendencia</MudTh>
                    <MudTh>Confianza</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Periodo</MudTd>
                    <MudTd Numeric="true">@(context.KgsVolcados > 0 ? context.KgsVolcados.ToString("N0") : "-")</MudTd>
                    <MudTd Numeric="true">@(context.KgsProyectados > 0 ? context.KgsProyectados.ToString("N0") : "-")</MudTd>
                    <MudTd Numeric="true">
                        @if (context.Tendencia > 0)
                        {
                            <MudChip Color="Color.Success" Size="Size.Small">@($"+{context.Tendencia:F1}%")</MudChip>
                        }
                        else if (context.Tendencia < 0)
                        {
                            <MudChip Color="Color.Error" Size="Size.Small">@($"{context.Tendencia:F1}%")</MudChip>
                        }
                        else
                        {
                            <MudChip Color="Color.Default" Size="Size.Small">0%</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudProgressLinear Value="@(context.EsProyectado ? 80 : 100)" Color="Color.Primary" Class="w-100" />
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@(context.EsProyectado ? "80%" : "100%")</MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <!-- Panel de IA interactivo -->
            <MudText Typo="Typo.h6" GutterBottom="true" Class="mt-4" Color="Color.Primary">🤖 Análisis IA de la Proyección</MudText>

            <MudGrid>
                <!-- Estacionalidad -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Style="border-left: 4px solid #3d6fb0;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">📊 Estacionalidad</MudText>
                            <MudText Typo="Typo.body1">Se detecta un patrón estacional en la proyección.</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@OnExplicarEstacionalidad" Class="mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> Explicar
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <!-- Tendencia -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Style="border-left: 4px solid #4caf50;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">📈 Tendencia General</MudText>
                            <MudText Typo="Typo.body1">
                                Tendencia <strong>@(_tendenciaPromedio >= 0 ? "positiva" : "negativa")</strong>
                                del @($"{Math.Abs(_tendenciaPromedio):F1}%") para los próximos @_proyectados.Count meses.
                            </MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@OnExplicarTendencia" Class="mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> Explicar
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <!-- Recomendación -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Style="border-left: 4px solid #ff9800;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">⚠️ Recomendación IA</MudText>
                            <MudText Typo="Typo.body1">Preparar capacidad extra para el mes pico proyectado: <strong>@(_mesPico?.Periodo ?? "N/A")</strong></MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@OnExplicarRecomendacion" Class="mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> Explicar
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <DataSourceFooter EsDummy="@_esDummy" Origen="Base de datos DTrace + IA (Proyección)" FechaActualizacion="@DateTime.Now" TotalRegistros="@_data.Count" />
        }
        else if (!_loading && _cargado)
        {
            <MudAlert Severity="Severity.Info">No se encontraron datos.</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<ProyeccionDto> _data = new();
    private List<ProyeccionDto> _proyectados = new();
    private ProyeccionDto? _mesPico;
    private decimal _tendenciaPromedio;
    private bool _esDummy;
    private bool _loading = false;
    private bool _cargado = false;
    private List<ChartSeriesItem> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();
    private int _chartKey;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _loading = true;
        _cargado = false;
        try
        {
            var resultado = await Mediator.Send(new GetProyeccionQuery());
            _data = resultado.Datos;
            _esDummy = resultado.EsDummy;

            // EsProyectado reemplaza la comparación implícita "KgsVolcados == 0"
            // que se usaba antes para inferir qué filas eran proyección a futuro.
            _proyectados = _data.Where(x => x.EsProyectado).ToList();
            _mesPico = _proyectados.OrderByDescending(x => x.KgsProyectados).FirstOrDefault();
            _tendenciaPromedio = _proyectados.Any() ? _proyectados.Average(x => x.Tendencia) : 0;

            LoadCharts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            _cargado = true;
            StateHasChanged();
        }
    }

    void LoadCharts()
    {
        var sorted = _data.OrderBy(x => x.Año).ThenBy(x => x.Mes).ToList();

        // Antes no se pasaba Labels al componente, por eso el eje X mostraba
        // "Dato 1... Dato N" en vez del período real (ej. "Ene 2026").
        _chartLabels = sorted.Select(x => x.Periodo ?? string.Empty).ToArray();

        var historico = sorted.Where(x => !x.EsProyectado).Select(x => (double)x.KgsVolcados).ToArray();
        var proyectado = sorted.Select(x => (double)x.KgsProyectados).ToArray();
        if (historico.Length == 0)
            historico = new double[proyectado.Length];
        else if (historico.Length < proyectado.Length)
        {
            var historicoCompleto = new double[proyectado.Length];
            for (int i = 0; i < historico.Length; i++)
                historicoCompleto[i] = historico[i];
            historico = historicoCompleto;
        }
        _chartSeries = new List<ChartSeriesItem>
        {
            new ChartSeriesItem { Name = "Histórico", Data = historico },
            new ChartSeriesItem { Name = "Proyección", Data = proyectado }
        };

        // Fuerza a InteractiveChart a remontarse con los datos/labels nuevos en vez
        // de reusar la instancia anterior (mismo patrón que en Dashboard.razor).
        _chartKey++;
    }

    private async Task OnExplicarEstacionalidad()
    {
        await NavegarAlChatAsync("estacionalidad");
    }

    private async Task OnExplicarTendencia()
    {
        await NavegarAlChatAsync("tendencia");
    }

    private async Task OnExplicarRecomendacion()
    {
        await NavegarAlChatAsync("recomendacion");
    }

    private async Task NavegarAlChatAsync(string tipo)
    {
        var template = await PromptProvider.GetPromptAsync(tipo);

        var peaks = _proyectados
            .GroupBy(x => x.Mes)
            .Select(g => new { Mes = g.Key, Total = g.Sum(p => p.KgsProyectados) })
            .OrderByDescending(g => g.Total)
            .Take(4)
            .Select(g => CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Mes))
            .ToList();
        var peaksText = peaks.Any() ? string.Join(", ", peaks) : "meses identificados";

        var historicos = _data.Where(x => !x.EsProyectado).ToList();
        var promedioHistorico = historicos.DefaultIfEmpty().Average(x => x?.KgsVolcados ?? 0);
        var promedioProyectado = _proyectados.DefaultIfEmpty().Average(x => x?.KgsProyectados ?? 0);
        var percentChange = promedioHistorico > 0 ? ((promedioProyectado - promedioHistorico) / promedioHistorico * 100) : 0;

        var maxProyectado = _mesPico;
        var maxPeriodo = maxProyectado?.Periodo ?? "mes pico";

        string prompt;
        if (!string.IsNullOrWhiteSpace(template))
        {
            prompt = template
                .Replace("{Peaks}", peaksText)
                .Replace("{AverageHistoric}", $"{promedioHistorico:N0}")
                .Replace("{AverageProjected}", $"{promedioProyectado:N0}")
                .Replace("{PercentChange}", $"{percentChange:F1}%")
                .Replace("{MaxPeriodo}", maxPeriodo)
                .Replace("{MaxProjected}", $"{maxProyectado?.KgsProyectados:N0}");
        }
        else
        {
            prompt = tipo switch
            {
                "estacionalidad" => $"Explica la estacionalidad detectada. Meses con mayor proyección: {peaksText}. ¿Qué factores podrían explicar estos picos?",
                "tendencia" => $"Analiza la tendencia: histórico promedio {promedioHistorico:N0} kgs vs proyectado {promedioProyectado:N0} kgs (cambio {percentChange:F1}%). ¿Qué factores podrían afectar esta proyección?",
                "recomendacion" => $"La recomendación es preparar capacidad extra para {maxPeriodo} (aprox. {maxProyectado?.KgsProyectados:N0} kgs proyectados). ¿Puedes describir el análisis que sustenta esta recomendación?",
                _ => "Genera un análisis con los datos de proyección.",
            };
        }

        NavigationManager.NavigateTo($"/iachat?mensaje={Uri.EscapeDataString(prompt)}");
    }
}
