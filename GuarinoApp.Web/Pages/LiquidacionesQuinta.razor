@page "/liquidacionesquinta"
@attribute [Authorize(Roles = "Admin, Gerencia, Contador")]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Common.Interfaces
@using GuarinoApp.Application.Modules.LiquidacionesQuinta.Queries.GetLiquidacionesQuinta
@using GuarinoApp.Application.Modules.LiquidacionesQuinta.Dtos
@using GuarinoApp.Web.Helpers
@inject IMediator Mediator
@inject IExportService ExportService
@inject IEmailService EmailService
@inject IReportMailRouter ReportMailRouter
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">🏡 Liquidaciones de Quinta</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Listado de Liquidaciones de Quinta</MudText>

<MudCard>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" Label="Año" Value="_anio" ValueChanged="OnAnioChanged" Dense="true"
                           Variant="Variant.Outlined" Style="max-width: 180px;" Disabled="@_loading">
                    <MudSelectItem T="int?" Value="@((int?)null)">Todos los años</MudSelectItem>
                    @foreach (var a in _anios)
                    {
                        <MudSelectItem T="int?" Value="@((int?)a)">@a</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData" Disabled="@_loading" FullWidth="true">
                    @(_loading ? "Cargando..." : "Actualizar")
                </MudButton>
            </MudItem>
        </MudGrid>

        <ExportToolbar ShowDateFilters="false"
                       ReportName="Liquidaciones_Quinta"
                       IsLoading="_loading"
                       OnExportPdf="ExportToPdf"
                       OnExportExcel="ExportToExcel"
                       OnExportCsv="ExportToCsv"
                       OnExportEmail="ExportarEmail" />

        @if (_data.Any())
        {
            <MudTable Items="@_data" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    @foreach (var prop in typeof(LiquidacionQuintaDto).GetProperties())
                    {
                        <MudTh>@prop.Name</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    @foreach (var prop in typeof(LiquidacionQuintaDto).GetProperties())
                    {
                        var value = prop.GetValue(context);
                        <MudTd>@value</MudTd>
                    }
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                                   RowsPerPageString="Filas por página:"
                                   InfoFormat="Mostrando {first_item}–{last_item} de {all_items} registros" />
                </PagerContent>
            </MudTable>

            <DataSourceFooter EsDummy="@_esDummy" Origen="@(_esDummy ? "Datos de ejemplo" : "Base de datos DTrace")" FechaActualizacion="@DateTime.Now" TotalRegistros="@_data.Count" />
        }
        else if (!_loading && _cargado)
        {
            <MudAlert Severity="Severity.Info">No se encontraron registros.</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<LiquidacionQuintaDto> _data = new();
    private List<int> _anios = new();
    private int? _anio;
    private bool _esDummy = false;
    private bool _loading = false;
    private bool _cargado = false;

    private async Task OnAnioChanged(int? anio)
    {
        _anio = anio;
        await LoadData();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _loading = true;
        _cargado = false;
        try
        {
            var resultado = await Mediator.Send(new GetLiquidacionesQuintaQuery(_anio));
            _data = resultado.Liquidaciones;
            _anios = resultado.Anios;
            _esDummy = resultado.EsDummy;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            _cargado = true;
            StateHasChanged();
        }
    }

    private async Task ExportToPdf()
    {
        if (!await EnsureDataForExportAsync()) return;
        try
        {
            var bytes = await ExportService.ExportToPdfAsync(_data, "Liquidaciones de Quinta");
            await DescargaHelper.DescargarAsync(JS, Snackbar, bytes, $"Liquidaciones_Quinta_{DateTime.Now:yyyyMMdd_HHmmss}.pdf", "application/pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exportando: {ex}");
            Snackbar.Add($"No se pudo generar el archivo: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportToExcel()
    {
        if (!await EnsureDataForExportAsync()) return;
        try
        {
            var bytes = await ExportService.ExportToExcelAsync(_data, "Liquidaciones de Quinta");
            await DescargaHelper.DescargarAsync(JS, Snackbar, bytes, $"Liquidaciones_Quinta_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exportando: {ex}");
            Snackbar.Add($"No se pudo generar el archivo: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportToCsv()
    {
        if (!await EnsureDataForExportAsync()) return;
        try
        {
            // DescargarTextoAsync antepone el BOM UTF-8: sin él, Excel en Windows
            // lee los acentos/ñ como "A?o". Igual que el resto de las páginas.
            await DescargaHelper.DescargarTextoAsync(JS, Snackbar, ExportService.ExportToCsv(_data), $"Liquidaciones_Quinta_{DateTime.Now:yyyyMMdd_HHmmss}.csv", "text/csv");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exportando: {ex}");
            Snackbar.Add($"No se pudo generar el archivo: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportarEmail()
    {
        if (!await EnsureDataForExportAsync()) return;
        try
        {
            var bytes = await ExportService.ExportToPdfAsync(_data, "Liquidaciones de Quinta");
            var nombreArchivo = $"Liquidaciones_Quinta_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";

            // Va al usuario que pidió el reporte, con copia al administrador.
            var (para, copia) = ReportMailRouter.GetRecipients();

            await EmailService.SendEmailAsync(
                para,
                $"Reporte Liquidaciones de Quinta {DateTime.Now:dd/MM/yyyy}",
                $"Adjunto el reporte de liquidaciones de quinta con {_data.Count} registros.",
                bytes,
                nombreArchivo,
                cc: copia);

            Snackbar.Add(copia == null
                    ? $"📧 Email enviado correctamente a {para}."
                    : $"📧 Email enviado correctamente a {para} (copia a {copia}).",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error enviando email: {ex}");
            Snackbar.Add($"⚠️ No se pudo enviar el email: {ex.Message}", Severity.Error,
                config => config.VisibleStateDuration = 8000);
        }
    }

    private Task<bool> EnsureDataForExportAsync()
    {
        if (_data.Any()) return Task.FromResult(true);
        Snackbar.Add("No hay datos para exportar.", Severity.Warning);
        return Task.FromResult(false);
    }
}

