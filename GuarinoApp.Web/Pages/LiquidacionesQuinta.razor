@page "/liquidacionesquinta"
@attribute [Authorize(Roles = "Admin, Gerencia, Contador")]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Modules.LiquidacionesQuinta.Queries.GetLiquidacionesQuinta
@using GuarinoApp.Application.Modules.LiquidacionesQuinta.Dtos
@inject IMediator Mediator

<MudText Typo="Typo.h4" GutterBottom="true">🏡 Liquidaciones de Quinta</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Listado de Liquidaciones de Quinta</MudText>

<MudCard>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" Label="Año" Value="_anio" ValueChanged="OnAnioChanged" Dense="true"
                           Variant="Variant.Outlined" Style="max-width: 180px;" Disabled="@_loading">
                    <MudSelectItem T="int?" Value="@((int?)null)">Todos los años</MudSelectItem>
                    @foreach (var a in _anios)
                    {
                        <MudSelectItem T="int?" Value="@((int?)a)">@a</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData" Disabled="@_loading" FullWidth="true">
                    @(_loading ? "Cargando..." : "Actualizar")
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_data.Any())
        {
            <MudTable Items="@_data" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    @foreach (var prop in typeof(LiquidacionQuintaDto).GetProperties())
                    {
                        <MudTh>@prop.Name</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    @foreach (var prop in typeof(LiquidacionQuintaDto).GetProperties())
                    {
                        var value = prop.GetValue(context);
                        <MudTd>@value</MudTd>
                    }
                </RowTemplate>
            </MudTable>

            <DataSourceFooter EsDummy="@_esDummy" Origen="@(_esDummy ? "Datos de ejemplo" : "Base de datos DTrace")" FechaActualizacion="@DateTime.Now" TotalRegistros="@_data.Count" />
        }
        else if (!_loading && _cargado)
        {
            <MudAlert Severity="Severity.Info">No se encontraron registros.</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<LiquidacionQuintaDto> _data = new();
    private List<int> _anios = new();
    private int? _anio;
    private bool _esDummy = false;
    private bool _loading = false;
    private bool _cargado = false;

    private async Task OnAnioChanged(int? anio)
    {
        _anio = anio;
        await LoadData();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _loading = true;
        _cargado = false;
        try
        {
            var resultado = await Mediator.Send(new GetLiquidacionesQuintaQuery(_anio));
            _data = resultado.Liquidaciones;
            _anios = resultado.Anios;
            _esDummy = resultado.EsDummy;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            _cargado = true;
            StateHasChanged();
        }
    }
}

