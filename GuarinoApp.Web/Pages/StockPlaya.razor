@page "/stockplaya"
@attribute [Authorize(Roles = RoleNames.TodosAutorizacion)]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Common.Filters
@using GuarinoApp.Application.Modules.StockPlaya.Queries.GetStockPlaya
@using GuarinoApp.Application.Modules.StockPlaya.Dtos
@inject IMediator Mediator

<MudText Typo="Typo.h4" GutterBottom="true">📦 Stock en Playa</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Fruta que quedó en la playa (estado <strong>E</strong> = "en playa") a la espera de despacho o volcado.
    Una fila por registro de emboquille con saldo en patio; el <strong>Saldo</strong> son bins restantes y el <strong>Kg Stock</strong> su valor en kilos.
</MudText>

<MudCard>
    <MudCardContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
        }
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudDatePicker @bind-Date="_fechaDesde" Label="Fecha Desde" DateFormat="dd-MM-yyyy" OnChange="@(() => Filtrar())" HelperText="Filtra por fecha de volcado; vacío = sin límite inferior." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudDatePicker @bind-Date="_fechaHasta" Label="Fecha Hasta" DateFormat="dd-MM-yyyy" OnChange="@(() => Filtrar())" HelperText="Filtra por fecha de volcado; vacío = hasta hoy." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTooltip Text="Vuelve a leer el stock en playa desde la base de datos.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData" Disabled="@_loading" FullWidth="true">
                    @(_loading ? "Cargando..." : "Actualizar")
                </MudButton>
                </MudTooltip>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Outlined" OnClick="@ClearFilters" Disabled="@_loading" FullWidth="true">Limpiar filtros</MudButton>
            </MudItem>
        </MudGrid>

        @* Filtros de Variedad/Productor: valores precargados desde los datos reales
           (MudSelect no admite texto libre) y filtrado en memoria junto a las fechas:
           la grilla, los gráficos y el total del pie reaccionan al instante. *@
        <MudGrid Class="mb-2">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="string" Label="Variedad" Value="_filtroVariedad" ValueChanged="OnVariedadChanged"
                           Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var v in _variedades)
                    {
                        <MudSelectItem Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="string" Label="Productor" Value="_filtroProductor" ValueChanged="OnProductorChanged"
                           Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var p in _productores)
                    {
                        <MudSelectItem Value="@p">@p</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (_data.Any())
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6">Stock por Variedad (Kilos)</MudText>
                    <InteractiveChart Series="_stockChartSeries" Type="InteractiveChartType.Bar" Height="300px" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6">Stock por Productor (Bins)</MudText>
                    <InteractiveChart Series="_productorChartSeries" Type="InteractiveChartType.Bar" Height="300px" />
                </MudItem>
            </MudGrid>

            <MudTable RowsPerPage="25" Items="@_visibles" Hover="true" Striped="true" Dense="true" SortLabel="Ordenar por">
                <HeaderContent>
                    <MudTh>Lote</MudTh><MudTh>Productor</MudTh><MudTh>Variedad</MudTh>
                    <MudTh>Ingresados</MudTh><MudTh>Volcados</MudTh><MudTh>Saldo</MudTh>
                    <MudTh>Kg Stock</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Lote</MudTd>
                    <MudTd>@context.Productor</MudTd>
                    <MudTd>@context.Variedad</MudTd>
                    <MudTd>@context.Ingresados</MudTd>
                    <MudTd>@context.Volcados</MudTd>
                    <MudTd>@context.Saldo</MudTd>
                    <MudTd>@context.KgStock.ToString("N0")</MudTd>
                </RowTemplate>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25 }" RowsPerPageString="Filas por página:" InfoFormat="Mostrando {first_item}–{last_item} de {all_items} registros" />
            </PagerContent>
            </MudTable>
        }
        else if (!_loading && _cargado)
        {
            <MudAlert Severity="Severity.Info">No se encontraron registros.</MudAlert>
        }
    <DataSourceFooter EsDummy="false" Origen="Base de datos DTrace (Producción)" FechaActualizacion="@DateTime.Now" TotalRegistros="@_visibles.Count()" />
</MudCardContent>
</MudCard>

@code {
    private List<StockPlayaDto> _data = new();
    private bool _loading = false;
    private bool _cargado = false;
    private DateTime? _fechaDesde = DateTime.Now.AddMonths(-3);
    private DateTime? _fechaHasta = DateTime.Now;
    private List<ChartSeriesItem> _stockChartSeries = new();
    private List<ChartSeriesItem> _productorChartSeries = new();
    private ChartOptions _chartOptions = new() { YAxisTicks = 3 };

    // Filtros de Variedad/Productor: valores precargados desde los datos reales
    // (el usuario elige, no tipea). Feccha llega como "yyyy.MM.dd", ordenable
    // como texto, así el rango de fechas se compara sin parsear.
    private string? _filtroVariedad;
    private string? _filtroProductor;
    private List<string> _variedades = new();
    private List<string> _productores = new();

    private IEnumerable<StockPlayaDto> _visibles =>
        _data.Where(d =>
            (_fechaDesde == null || string.CompareOrdinal(d.Feccha, _fechaDesde.Value.ToString("yyyy.MM.dd")) >= 0) &&
            (_fechaHasta == null || string.CompareOrdinal(d.Feccha, _fechaHasta.Value.ToString("yyyy.MM.dd")) <= 0) &&
            (_filtroVariedad == null || d.Variedad == _filtroVariedad) &&
            (_filtroProductor == null || d.Productor == _filtroProductor));

    private void OnVariedadChanged(string? valor) { _filtroVariedad = valor; LoadCharts(); }
    private void OnProductorChanged(string? valor) { _filtroProductor = valor; LoadCharts(); }

    // Cualquier cambio de filtro rehace gráficos y estado sin volver a la BD.
    private void Filtrar()
    {
        LoadCharts();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _loading = true;
        _cargado = false;
        try
        {
            _data = await Mediator.Send(new GetStockPlayaQuery(new List<Filter>()));

            // Opciones de los selects = valores distintos reales del resultado;
            // si tras recargar una selección ya no existe, se limpia.
            _variedades = _data.Select(d => d.Variedad!).Where(v => !string.IsNullOrWhiteSpace(v))
                .Distinct().OrderBy(v => v, StringComparer.Ordinal).ToList();
            _productores = _data.Select(d => d.Productor!).Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct().OrderBy(p => p, StringComparer.Ordinal).ToList();
            if (_filtroVariedad != null && !_variedades.Contains(_filtroVariedad)) _filtroVariedad = null;
            if (_filtroProductor != null && !_productores.Contains(_filtroProductor)) _filtroProductor = null;

            LoadCharts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            _cargado = true;
            StateHasChanged();
        }
    }

    // Gráficos sobre las filas visibles, para que sigan los filtros de fecha,
    // variedad y productor.
    void LoadCharts()
    {
        var visibles = _visibles.ToList();

        var varietyStock = visibles.GroupBy(x => x.Variedad)
            .Select(g => new { Name = g.Key ?? "Sin variedad", Value = g.Sum(x => x.KgStock) })
            .OrderByDescending(x => x.Value)
            .Take(10)
            .ToList();

        _stockChartSeries = new List<ChartSeriesItem>
        {
            new ChartSeriesItem { Name = "Kg Stock", Data = varietyStock.Select(x => (double)x.Value).ToArray() }
        };

        var productorStock = visibles.GroupBy(x => x.Productor)
            .Select(g => new { Name = g.Key ?? "Sin productor", Value = g.Sum(x => x.Saldo) })
            .OrderByDescending(x => x.Value)
            .Take(10)
            .ToList();

        _productorChartSeries = new List<ChartSeriesItem>
        {
            new ChartSeriesItem { Name = "Bins en stock", Data = productorStock.Select(x => (double)x.Value).ToArray() }
        };
    }

    void ClearFilters()
    {
        _fechaDesde = DateTime.Now.AddMonths(-3);
        _fechaHasta = DateTime.Now;
        _filtroVariedad = null;
        _filtroProductor = null;
        Filtrar();
    }
}
