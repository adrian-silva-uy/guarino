@page "/contaduria"
@attribute [Authorize(Roles = "Admin, Gerencia, Contador")]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Common.Dtos
@using GuarinoApp.Application.Common.Helpers
@using GuarinoApp.Application.Common.Interfaces
@using GuarinoApp.Application.Modules.Contaduria.Queries.GetFinancialData
@using GuarinoApp.Application.Modules.Contaduria.Commands.UpdateFinancialData
@using GuarinoApp.Application.Modules.Contaduria.Dtos
@using GuarinoApp.Application.Modules.Contaduria.Services
@using GuarinoApp.Application.Modules.Contaduria.Queries.GetContextoOperativo
@using GuarinoApp.Application.Modules.Proyeccion.Dtos
@using GuarinoApp.Application.Modules.Proyeccion.Queries.GetProyeccionZafra
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IAIService AIService
@inject Microsoft.Extensions.Logging.ILogger<Contaduria> Logger

<PageTitle>Contaduría - Datos Financieros</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark">📊 Contaduría</h2>
            <p class="text-muted mb-0">Ingreso de datos financieros para KPIs y proyecciones</p>
        </div>
        @if (_data != null)
        {
            <span class="badge bg-info text-white">Última actualización: @(_data.FechaActualizacion.ToString("dd/MM/yyyy HH:mm"))</span>
        }
    </div>

    @* Sin MudIcon propio: MudAlert ya dibuja su ícono de severidad (queda duplicado) *@
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Estos datos alimentan los cálculos de <strong>Capital de Trabajo</strong>, <strong>Riesgo de Liquidez</strong> y <strong>CAPEX</strong> en el tablero de Proyección de Zafra.
    </MudAlert>

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else
    {
        @* ====== KPIs de decisión (mismos números que usa el tablero de zafra) ====== *@
        <MudGrid Class="mb-4">
            <MudItem xs="6" md="3">
                <MudCard Elevation="2" Style="height: 100%;">
                    <MudCardContent Class="pb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase fw-bold">Capital de trabajo</MudText>
                        <MudText Typo="Typo.h5">@(_kpi != null ? $"${_kpi.CapitalNecesario:N0}" : "N/D")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@(_volumenProyectado > 0 ? $"{_volumenProyectado:N0} kg proyectados × costo/kg" : "Sin proyección cargada")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudCard Elevation="2" Style="height: 100%;">
                    <MudCardContent Class="pb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase fw-bold">Brecha de caja</MudText>
                        <MudText Typo="Typo.h5" Style="@_estiloBrecha">@(_kpi != null ? $"${_kpi.BrechaLiquidez:N0}" : "N/D")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@(_kpi != null && _kpi.BrechaLiquidez <= 0 ? "Caja suficiente" : "Faltante vs. capital requerido")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudCard Elevation="2" Style="height: 100%;">
                    <MudCardContent Class="pb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase fw-bold">Riesgo de liquidez</MudText>
                        <MudText Typo="Typo.h5" Style="@(_kpi != null ? _estiloRiesgo : "")">@(_kpi?.RiesgoLiquidez ?? "N/D")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Caja $@(_data?.FlujoCaja.ToString("N0") ?? "—")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudCard Elevation="2" Style="height: 100%;">
                    <MudCardContent Class="pb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase fw-bold">Ocupación de capacidad</MudText>
                        <MudText Typo="Typo.h5">@_ocupacionTexto</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@(_data is { CapacidadInstalada: > 0 } ? $"{_data.CapacidadInstalada:N0} kg instalados" : "Capacidad sin cargar")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-3">Datos Financieros</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_costoPorKg"
                                         Label="Costo por Kg ($)"
                                         Variant="Variant.Outlined"
                                         Min="0m"
                                         Step="0.01m"
                                         Format="N2"
                                         Required="true"
                                         HelperText="Costo operativo promedio por kg (últimos 3 años)" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_flujoCaja"
                                         Label="Flujo de Caja ($)"
                                         Variant="Variant.Outlined"
                                         Min="0m"
                                         Step="1000m"
                                         Format="N0"
                                         Required="true"
                                         HelperText="Caja disponible actual" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_margenBruto"
                                         Label="Margen Bruto (%)"
                                         Variant="Variant.Outlined"
                                         Min="0m"
                                         Max="100m"
                                         Step="0.1m"
                                         Format="N1"
                                         Required="true"
                                         HelperText="Margen bruto histórico promedio" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_costoFlete"
                                         Label="Costo Flete por Contenedor ($)"
                                         Variant="Variant.Outlined"
                                         Min="0m"
                                         Step="100m"
                                         Format="N0"
                                         HelperText="Opcional - costo promedio de flete" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_capacidadInstalada"
                                         Label="Capacidad Instalada (kg)"
                                         Variant="Variant.Outlined"
                                         Min="0m"
                                         Step="1000m"
                                         Format="N0"
                                         Required="true"
                                         HelperText="Máximo que la empresa puede procesar sin tercerizar" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_observaciones"
                                      Label="Observaciones"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      HelperText="Notas adicionales sobre los datos ingresados" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <MudTooltip Text="Deja los campos en blanco para cargar otras cifras (no se guarda nada hasta que apliques Guardar Datos).">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="LimpiarFormulario"
                               Disabled="_loading">
                        Limpiar
                    </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Valida las cifras, guarda los datos y recalcula KPIs y análisis con IA.">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="GuardarDatos"
                               Disabled="_loading"
                               StartIcon="@Icons.Material.Filled.Save">
                        @(_loading ? "Guardando..." : "Guardar Datos")
                    </MudButton>
                    </MudTooltip>
                </div>
            </MudCardContent>
        </MudCard>

        @if (_data != null)
        {
            <MudCard Elevation="1" Class="mt-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" GutterBottom="true">Resumen de Datos Actuales</MudText>
                    <MudGrid>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Costo/Kg</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">$@_data.CostoPorKg.ToString("N2")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Flujo de Caja</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">$@_data.FlujoCaja.ToString("N0")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Margen Bruto</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">@_data.MargenBruto.ToString("N1")%</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Capacidad</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">@_data.CapacidadInstalada.ToString("N0") kg</MudText>
                        </MudItem>
                    </MudGrid>
                    @if (!string.IsNullOrEmpty(_data.ActualizadoPor))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
                            Actualizado por: @_data.ActualizadoPor
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        }

        @* ====== Datos operativos: se calculan solos desde otros módulos ====== *@
        @if (_operativo is { HayDatos: true })
        {
            <MudCard Elevation="1" Class="mt-4">
                <MudCardContent>
                    <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-2">
                        <MudText Typo="Typo.h6">📉 Datos operativos (automáticos)</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                            Se calculan desde Liquidaciones · Pesadas · Stock · Pallets
                        </MudChip>
                    </div>
                    <MudGrid>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">A pagar a productores</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">
                                @(_operativo.PagarAProductores is decimal pag ? $"${pag:N0}" : "—")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @(_operativo.LiquidacionesKgs is decimal lk
                                    ? $"{lk:N0} kg · {_operativo.LiquidacionesBins:N0} bins · {_operativo.Anio}"
                                    : $"sin liquidaciones en {_operativo.Anio}")
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Avance de cosecha</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">
                                @(_operativo.KgsVolcadosAnio is decimal kv ? $"{kv:N0} kg" : "—")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @(_operativo.KgsVolcadosAnio is decimal kv2
                                    ? (_operativo.Anio == _proyectada?.Año && _volumenProyectado > 0
                                        ? $"{kv2 / _volumenProyectado * 100:N1}% de los {_volumenProyectado:N0} kg proyectados"
                                        : $"volcados en {_operativo.Anio} · zafra {_proyectada?.Año.ToString() ?? "—"}: {_volumenProyectado:N0} kg proyectados")
                                    : "sin volcados en el año")
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Stock en playa</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">
                                @(_operativo.StockPlayaKg is decimal sp ? $"{sp:N0} kg" : "—")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Fruta en patio sin despachar ni volcar</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Pallets sin cliente</MudText>
                            <MudText Typo="Typo.h6" Class="fw-bold">
                                @(_operativo.PalletsSinCliente is int ps ? $"{ps:N0}" : "—")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @(_operativo.PalletsSinClienteKg is decimal pk && pk > 0 ? $"{pk:N0} kg inmovilizados" : "con cliente asignado")
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        }

        @* ====== Análisis para Contaduría: local de inmediato, la IA refina en segundo plano ====== *@
        <MudCard Elevation="2" Class="mt-4">
            <MudCardContent>
                <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-2">
                    <MudText Typo="Typo.h6"> Análisis Financiero para Contaduría</MudText>
                    @if (_refinadoConIA)
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome">
                            Plan refinado con análisis de IA
                        </MudChip>
                    }
                    else if (_analizando)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" Style="width:14px;height:14px;" /> Refinando con análisis de IA…
                        </MudText>
                    }
                </div>

                @if (_analisis != null)
                {
                    <MudText Typo="Typo.body1" Class="mb-3">@_analisis.Lectura</MudText>

                    @if (_analisis.Hallazgos.Any())
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Hallazgos</MudText>
                        <MudGrid Class="mb-3">
                            @foreach (var h in _analisis.Hallazgos)
                            {
                                <MudItem xs="12" md="6" lg="4">
                                    <MudCard Elevation="0" Style="@($"border-left: 4px solid {ColorDeSeveridad(h.Severidad)}; background: #f8f9fa; height: 100%;")">
                                        <MudCardContent Class="pb-2">
                                            <MudText Typo="Typo.body2" Class="fw-bold">@h.Titulo</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@h.Detalle</MudText>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }

                    @if (_analisis.Acciones.Any())
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Acciones sugeridas</MudText>
                        @foreach (var a in _analisis.Acciones)
                        {
                            <MudCard Elevation="0" Class="mb-2" Style="background: #f8f9fa;">
                                <MudCardContent Class="py-2">
                                    <div class="d-flex flex-wrap justify-space-between align-start gap-2">
                                        <MudText Typo="Typo.body2">@a.Texto</MudText>
                                        <div class="d-flex gap-2">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@a.Plazo</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@a.Impacto</MudChip>
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    }
                }
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    private bool _loading = false;
    private FinancialDataDto? _data;

    private decimal _costoPorKg = 0;
    private decimal _flujoCaja = 0;
    private decimal _margenBruto = 0;
    private decimal? _costoFlete = null;
    private decimal _capacidadInstalada = 0;
    private string? _observaciones = null;

    // KPIs de decisión + análisis (local de inmediato; la IA refina en segundo plano)
    private FinancialKpiDto? _kpi;
    private decimal _volumenProyectado;
    private ZafraDto? _proyectada;
    private ContextoOperativoContaduriaDto? _operativo;
    private ModuloInsightDto? _analisis;
    private bool _analizando;
    private bool _refinadoConIA;
    private int _correlativoIA = 0; // invalida respuestas viejas si se guarda en el medio

    private string _ocupacionTexto =>
        _data is { CapacidadInstalada: > 0 } && _volumenProyectado > 0
            ? $"{_volumenProyectado / _data.CapacidadInstalada * 100:N1}%"
            : "N/D";

    private string _estiloBrecha =>
        _kpi == null ? "" :
        _kpi.BrechaLiquidez <= 0 ? "color: #388e3c;" :
        _kpi.RiesgoLiquidez == "ALTO" ? "color: #d32f2f;" :
        _kpi.RiesgoLiquidez == "MEDIO" ? "color: #fbc02d;" : "";

    private string _estiloRiesgo => (_kpi?.RiesgoLiquidez) switch
    {
        "ALTO" => "color: #d32f2f;",
        "MEDIO" => "color: #fbc02d;",
        "N/D" => "color: #9e9e9e;",
        _ => "color: #388e3c;"
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _data = await Mediator.Send(new GetFinancialDataQuery());

            if (_data != null)
            {
                _costoPorKg = _data.CostoPorKg;
                _flujoCaja = _data.FlujoCaja;
                _margenBruto = _data.MargenBruto;
                _costoFlete = _data.CostoFlete;
                _capacidadInstalada = _data.CapacidadInstalada;
                _observaciones = _data.Observaciones;
            }

            await CalcularKPIsYAnalisisAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar datos financieros");
            Snackbar.Add("Error al cargar los datos", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task GuardarDatos()
    {
        // Validaciones mínimas: un costo o capacidad en cero se guardaría en
        // silencio y rompería los KPIs de Proyección de Zafra (capital = kg
        // proyectados × costo/kg). Se avisa y NO se guarda nada.
        if (_costoPorKg <= 0)
            {
            Snackbar.Add("El costo por kg debe ser mayor a 0. No se guardó nada.", Severity.Warning);
            return;
            }
        if (_flujoCaja < 0)
            {
            Snackbar.Add("El flujo de caja no puede ser negativo. No se guardó nada.", Severity.Warning);
            return;
            }
        if (_margenBruto < 0 || _margenBruto > 100)
            {
            Snackbar.Add("El margen bruto debe estar entre 0 y 100 %. No se guardó nada.", Severity.Warning);
            return;
            }
        if (_costoFlete.HasValue && _costoFlete.Value < 0)
            {
            Snackbar.Add("El costo de flete no puede ser negativo. No se guardó nada.", Severity.Warning);
            return;
            }
        if (_capacidadInstalada <= 0)
            {
            Snackbar.Add("La capacidad instalada debe ser mayor a 0. No se guardó nada.", Severity.Warning);
            return;
            }

        _loading = true;
        StateHasChanged();

        try
        {
            var command = new UpdateFinancialDataCommand(
                _costoPorKg,
                _flujoCaja,
                _margenBruto,
                _costoFlete,
                _capacidadInstalada,
                _observaciones
            );

            _data = await Mediator.Send(command);
            Snackbar.Add("Datos financieros guardados correctamente", Severity.Success);

            // Las cifras cambiaron: se recalculan KPIs y análisis con los valores nuevos.
            await CalcularKPIsYAnalisisAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar datos financieros");
            Snackbar.Add("Error al guardar los datos", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// KPIs con FinancialKpiCalculator — la misma fuente que el tablero de Proyección
    /// de Zafra— para que capital, brecha y riesgo sean idénticos en ambas pantallas.
    /// Luego construye el análisis local y dispara el refinamiento con IA en background.
    /// </summary>
    private async Task CalcularKPIsYAnalisisAsync()
    {
        try
        {
            var zafras = await Mediator.Send(new GetProyeccionZafraQuery());
            var proyectada = zafras?.FirstOrDefault(z => z.Estado == "Proyectado") ?? zafras?.FirstOrDefault();
            _proyectada = proyectada;
            if (proyectada != null)
            {
                _volumenProyectado = proyectada.TotalKgs;
                _kpi = FinancialKpiCalculator.Calcular(
                    proyectada.TotalKgs, proyectada.CapacidadMaximaHistoricaKgs ?? 0m, _data);
            }
            else
            {
                _volumenProyectado = 0;
                _kpi = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo cargar la proyección de zafra para los KPIs de Contaduría");
        }

        await CargarContextoOperativoAsync();

        _analisis = AnalisisContaduriaBuilder.Construir(_data, _kpi, _volumenProyectado);
        _refinadoConIA = false;

        var token = ++_correlativoIA;
        _ = AnalizarConIAAsync(token);
    }

    /// <summary>
    /// Carga los datos operativos automáticos (liquidaciones del año, avance de
    /// cosecha, stock en playa y pallets sin cliente) desde sus tablas fuente.
    /// Es enriquecimiento opcional: si falla, la página sigue funcionando sin ellos.
    /// </summary>
    private async Task CargarContextoOperativoAsync()
    {
        try
        {
            // Ejercicio en curso: liquidaciones y volcados del año actual son lo
            // que al contador le interesa (la zafra proyectada del año siguiente
            // aún no arrancó y daría "0 / sin datos" sin valor de gestión).
            _operativo = await Mediator.Send(new GetContextoOperativoQuery(DateTime.Today.Year));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo cargar el contexto operativo de Contaduría");
            _operativo = null;
        }
    }

    /// <summary>
    /// Refina el análisis con IA EN SEGUNDO PLANO: la tarjeta ya muestra la versión
    /// local con las mismas cifras del formulario; si el análisis de IA responde y se
    /// parsea correctamente (EsIA), se reemplaza el texto y aparece el chip. Si falla,
    /// no cambia nada en pantalla.
    /// </summary>
    private async Task AnalizarConIAAsync(int token)
    {
        try
        {
            _analizando = true;
            await InvokeAsync(StateHasChanged);

            var contexto = AnalisisContaduriaBuilder.ConstruirContextoJson(_data, _kpi, _volumenProyectado, _proyectada, _operativo);
            var resultado = await AIService.GetAnalisisDeModuloAsync("ContaduriaAnalisis", contexto);

            if (resultado is { EsIA: true } &&
                (!string.IsNullOrWhiteSpace(resultado.Lectura) || resultado.Hallazgos.Any() || resultado.Acciones.Any()) &&
                token == _correlativoIA)
            {
                // Tarjeta híbrida: lo que la IA no trajo se conserva de la versión
                // local, para que la tarjeta siempre muestre lectura + hallazgos + acciones.
                if (string.IsNullOrWhiteSpace(resultado.Lectura))
                    resultado.Lectura = _analisis?.Lectura ?? string.Empty;
                if (!resultado.Hallazgos.Any())
                    resultado.Hallazgos = _analisis?.Hallazgos ?? new();
                if (!resultado.Acciones.Any())
                    resultado.Acciones = _analisis?.Acciones ?? new();

                if (string.IsNullOrWhiteSpace(resultado.Lectura) && !resultado.Hallazgos.Any() && !resultado.Acciones.Any())
                    return;

                _analisis = resultado;
                _refinadoConIA = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo refinar el análisis de Contaduría con IA; se conserva la versión local.");
        }
        finally
        {
            _analizando = false;
            if (token == _correlativoIA)
            {
                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch (ObjectDisposedException)
                {
                    // El usuario navegó fuera de la página mientras la IA respondía.
                }
            }
        }
    }

    private static string ColorDeSeveridad(string? severidad) => severidad?.ToLowerInvariant() switch
    {
        "alta" => "#d32f2f",
        "media" => "#fbc02d",
        _ => "#388e3c"
    };

    private void LimpiarFormulario()
    {
        _costoPorKg = 0;
        _flujoCaja = 0;
        _margenBruto = 0;
        _costoFlete = null;
        _capacidadInstalada = 0;
        _observaciones = null;
    }
}
