@page "/usuarios"
@attribute [Authorize(Roles = "Admin, Gerencia")]
@using GuarinoApp.Application.Modules.Auth.Dtos
@using GuarinoApp.Application.Modules.Auth.Queries.GetUsers
@using GuarinoApp.Application.Modules.Auth.Commands.UpdateUser
@inject IMediator Mediator
@inject ISnackbar Snackbar

<PageTitle>Usuarios - Guarino App</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Usuarios</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Administración de usuarios, roles y accesos de la aplicación.
</MudText>

@* La página solo renderiza para Admin y Gerencia gracias al [Authorize] de arriba
   (la URL directa de otro rol responde con el aviso de App.razor).
   Las reglas de negocio (quién activa, quién cambia roles) se validan server-side
   en UpdateUserCommandHandler. *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_users.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">Todavía no hay usuarios cargados.</MudAlert>
}
else
{
    <MudTable Items="_users" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="mt-2">
        <HeaderContent>
            <MudTh>Usuario</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Activo</MudTh>
            <MudTh>Estado desde</MudTh>
            <MudTh>Último acceso</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Usuario">
                <MudText Typo="Typo.body2">@context.UserName</MudText>
            </MudTd>
            <MudTd DataLabel="Nombre">@context.FullName</MudTd>
            <MudTd DataLabel="Rol">
                <MudSelect T="string"
                           Value="@context.Role"
                           ValueChanged="@(role => ChangeRoleAsync(context, role))"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="_saving">
                    <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                    <MudSelectItem Value="@("Gerencia")">Gerencia</MudSelectItem>
                    <MudSelectItem Value="@("Contador")">Contador</MudSelectItem>
                    <MudSelectItem Value="@("Operador")">Operador</MudSelectItem>
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Activo">
                @* Activar/desactivar es potestad exclusiva del Admin;
                   Gerencia solo consulta el estado. *@
                <AuthorizeView Roles="Admin" Context="authCtx">
                    <Authorized>
                        <MudSwitch T="bool"
                                   Checked="@context.IsActive"
                                   CheckedChanged="(active => ChangeActiveAsync(context, active))"
                                   Color="Color.Success"
                                   Disabled="_saving" />
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.body2">@(context.IsActive ? "Sí" : "No")</MudText>
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd DataLabel="Estado desde">
                @StateLabel(context)
            </MudTd>
            <MudTd DataLabel="Último acceso">
                @(context.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<AppUserDto> _users = new();
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    /// <summary>Estado con su fecha: "desde cuándo" está activo o inactivo.</summary>
    private static string StateLabel(AppUserDto user) =>
        user.IsActive
            ? $"Activo desde {user.ActivatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—"}"
            : $"Inactivo desde {user.DeactivatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—"}";

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _users = await Mediator.Send(new GetUsersQuery());
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangeRoleAsync(AppUserDto user, string role)
    {
        await SaveAsync(user, role: role);
    }

    private async Task ChangeActiveAsync(AppUserDto user, bool isActive)
    {
        await SaveAsync(user, isActive: isActive);
    }

    private async Task SaveAsync(AppUserDto user, string? role = null, bool? isActive = null)
    {
        _saving = true;
        try
        {
            var result = await Mediator.Send(new UpdateUserCommand(
                user.Id,
                role ?? user.Role,
                isActive ?? user.IsActive));

            if (result.Success)
            {
                Snackbar.Add("Cambios guardados.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "No se pudieron guardar los cambios.", Severity.Error);
                await LoadAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
