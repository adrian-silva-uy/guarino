@page "/usuarios"
@attribute [Authorize(Roles = "Admin, Gerencia")]
@using GuarinoApp.Application.Modules.Auth.Dtos
@using GuarinoApp.Application.Modules.Auth.Queries.GetUsers
@using GuarinoApp.Application.Modules.Auth.Queries.GetRoles
@using GuarinoApp.Application.Modules.Auth.Commands.UpdateUser
@using GuarinoApp.Application.Modules.Auth.Commands.CreateUser
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject ILogger<Usuarios> Logger

<PageTitle>Usuarios - Guarino App</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Usuarios</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Administración de usuarios, roles y accesos de la aplicación.
</MudText>

@* Alta de usuarios: exclusiva del Admin (el handler también lo valida
   server-side, la UI solo oculta la opción a los demás roles). *@
<AuthorizeView Roles="Admin">
    <Authorized>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="ToggleForm"
                   Disabled="_saving"
                   Class="mb-3">
            @(_showForm ? "Cerrar formulario" : "Nuevo usuario")
        </MudButton>

        @if (_showForm)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Nuevo usuario</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="_newUser.UserName"
                                      Label="Usuario"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Mínimo 3 caracteres" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="_newUser.FullName"
                                      Label="Nombre completo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="_newUser.Password"
                                      Label="Contraseña"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Mínimo 6 caracteres" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        @* Los roles vienen de la tabla Roles (fuente única de verdad). *@
                        <MudSelect T="string"
                                   @bind-Value="_newUser.Role"
                                   Label="Rol"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true">
                            @foreach (var roleName in _roles)
                            {
                                <MudSelectItem Value="@roleName">@roleName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Spacing="2" Class="mt-3">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="CrearUsuarioAsync"
                               Disabled="_saving">
                        Crear usuario
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               OnClick="CancelarForm"
                               Disabled="_saving">
                        Cancelar
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    </Authorized>
</AuthorizeView>

@* La página solo renderiza para Admin y Gerencia gracias al [Authorize] de arriba
   (la URL directa de otro rol responde con el aviso de App.razor).
   Las reglas de negocio (quién activa, quién cambia roles) se validan server-side
   en UpdateUserCommandHandler. *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_users.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">Todavía no hay usuarios cargados.</MudAlert>
}
else
{
    <MudTable Items="_users" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="mt-2">
        <HeaderContent>
            <MudTh>Usuario</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Activo</MudTh>
            <MudTh>Estado desde</MudTh>
            <MudTh>Último acceso</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Usuario">
                <MudText Typo="Typo.body2">@context.UserName</MudText>
            </MudTd>
            <MudTd DataLabel="Nombre">@context.FullName</MudTd>
            <MudTd DataLabel="Rol">
                <MudSelect T="string"
                           Value="@context.Role"
                           ValueChanged="@(role => ChangeRoleAsync(context, role))"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="_saving">
                    @foreach (var roleName in _roles)
                    {
                        <MudSelectItem Value="@roleName">@roleName</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Activo">
                @* Activar/desactivar es potestad exclusiva del Admin;
                   Gerencia solo consulta el estado. *@
                <AuthorizeView Roles="Admin" Context="authCtx">
                    <Authorized>
                        <MudSwitch T="bool"
                                   Checked="@context.IsActive"
                                   CheckedChanged="(active => ChangeActiveAsync(context, active))"
                                   Color="Color.Success"
                                   Disabled="_saving" />
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.body2">@(context.IsActive ? "Sí" : "No")</MudText>
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd DataLabel="Estado desde">
                @StateLabel(context)
            </MudTd>
            <MudTd DataLabel="Último acceso">
                @(context.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<AppUserDto> _users = new();
    private List<string> _roles = new();
    private bool _loading = true;
    private bool _saving;
    private bool _showForm;
    private NuevoUsuario _newUser = new();

    /// <summary>Datos del formulario de alta (la contraseña solo vive en
    /// memoria hasta hashearse en el servidor).</summary>
    private sealed class NuevoUsuario
    {
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "Operador";
    }

    private void ToggleForm()
    {
        _showForm = !_showForm;
        if (_showForm)
            _newUser = new NuevoUsuario();
    }

    private void CancelarForm()
    {
        _showForm = false;
        _newUser = new NuevoUsuario();
    }

    private async Task CrearUsuarioAsync()
    {
        _saving = true;
        try
        {
            var result = await Mediator.Send(new CreateUserCommand(
                _newUser.UserName,
                _newUser.FullName,
                _newUser.Password,
                _newUser.Role));

            if (result.Success)
            {
                Snackbar.Add("Usuario creado correctamente.", Severity.Success);
                CancelarForm();
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "No se pudo crear el usuario.", Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarRolesAsync();
        await LoadAsync();
    }

    /// <summary>Carga los roles desde la tabla Roles (fuente única de verdad
    /// de la lista). Si falla, los selects quedan vacíos pero el resto de la
    /// página sigue funcionando y el server-side rechazará altas inválidas.</summary>
    private async Task CargarRolesAsync()
    {
        try
        {
            _roles = await Mediator.Send(new GetRolesQuery());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar los roles");
        }
    }

    /// <summary>Estado con su fecha: "desde cuándo" está activo o inactivo.</summary>
    private static string StateLabel(AppUserDto user) =>
        user.IsActive
            ? $"Activo desde {user.ActivatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—"}"
            : $"Inactivo desde {user.DeactivatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—"}";

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _users = await Mediator.Send(new GetUsersQuery());
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangeRoleAsync(AppUserDto user, string role)
    {
        await SaveAsync(user, role: role);
    }

    private async Task ChangeActiveAsync(AppUserDto user, bool isActive)
    {
        await SaveAsync(user, isActive: isActive);
    }

    private async Task SaveAsync(AppUserDto user, string? role = null, bool? isActive = null)
    {
        _saving = true;
        try
        {
            var result = await Mediator.Send(new UpdateUserCommand(
                user.Id,
                role ?? user.Role,
                isActive ?? user.IsActive));

            if (result.Success)
            {
                Snackbar.Add("Cambios guardados.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "No se pudieron guardar los cambios.", Severity.Error);
                await LoadAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
