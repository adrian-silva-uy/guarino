@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace GuarinoApp.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <!-- CSS propio -->
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />

    <!-- CSS generado por Blazor -->
    <link href="GuarinoApp.Web.styles.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <!-- MudBlazor -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>

<body>

    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui">
        Ha ocurrido un error.
        <a href="" class="reload">Recargar</a>
        <a class="dismiss">🗙</a>
    </div>

    <!-- Scripts externos y de Blazor -->
    <script src="js/apexcharts.min.js" defer></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        Blazor.start();
    </script>

    <!-- Funciones globales de descarga e interop JavaScript -->
    <script>
        window.downloadFile = function (filename, base64Data) {
            const link = document.createElement('a');
            link.download = filename;
            link.href = 'data:application/octet-stream;base64,' + base64Data;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.downloadFileFromText = function (fileName, text, mimeType) {
            const blob = new Blob([text], { type: mimeType || 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);
        };

        window.downloadFileFromByteArray = function (fileName, byteArray, mimeType) {
            const blob = new Blob([byteArray], { type: mimeType || 'application/octet-stream' });
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);
        };

        window.downloadFileFromStream = async function (fileName, contentStreamReference) {
            const arrayBuffer = await contentStreamReference.arrayBuffer();
            const blob = new Blob([arrayBuffer]);
            const url = URL.createObjectURL(blob);
            const anchorElement = document.createElement('a');
            anchorElement.href = url;
            anchorElement.download = fileName;
            document.body.appendChild(anchorElement);
            anchorElement.click();
            anchorElement.remove();
            URL.revokeObjectURL(url);
        };

        // Diálogo nativo "Guardar como..." (File System Access API) para que el
        // usuario elija dónde guardar el archivo. Requiere Chromium + contexto
        // seguro (HTTPS o localhost); en el resto de navegadores/contextos cae
        // a la descarga automática (carpeta de descargas del navegador).
        // Devuelve: "guardado" | "cancelado" | "descargado".
        // Robustez (archivos de 0 bytes):
        //  - write() recibe un Blob con MIME explícito (no un Uint8Array crudo).
        //  - Si el picker/createWritable()/write() falla, se aborta el writable
        //    (descarta el temporal) y SE SIGUE con la descarga automática: nunca
        //    queda un archivo vacío a medias.
        //  - AbortError "instantáneo" (<700 ms) = el diálogo ni siquiera se
        //    mostró (ventana minimizada / sin gesto): NO es cancelación del
        //    usuario → se descarga igual en vez de informar "cancelado".
        //  - revokeObjectURL diferido: revocar en el mismo tick puede cancelar
        //    la descarga en curso en Chromium.
        window.saveAsFromBase64 = async function (fileName, base64, mimeType) {
            const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
            const mime = mimeType || 'application/octet-stream';
            // Clave MIME sin parámetros para el picker: showSaveFilePicker rechaza
            // claves con ';' (p. ej. "text/csv;charset=utf-8;") con TypeError y el
            // diálogo "Guardar como" nunca se ofrecía en esas páginas.
            const mimeBase = mime.split(';')[0].trim();
            const ext = fileName.lastIndexOf('.') >= 0 ? fileName.slice(fileName.lastIndexOf('.')) : '';
            const ahora = () => (typeof performance !== 'undefined' ? performance.now() : Date.now());

            // Si el diálogo "Guardar como" ya falló al ESCRIBIR en esta sesión
            // (Chromium crea el archivo destino de0bytes y después createWritable
            // puede ser rechazado por el contexto), no se vuelve a ofrecer ese
            // diálogo: se descarga directo a la carpeta de descargas del navegador
            // para no dejar archivos vacíos en la carpeta que eligió el usuario.
            if (window.showSaveFilePicker && !sessionStorage.getItem('guarino_save_picker_bloqueado')) {
                const t0 = ahora();
                let handle = null;
                let writable = null;
                const pedirPermiso = async () => {
                    // Algunos contextos exigen pedir el permiso de escritura
                    // explícitamente después de elegir el archivo.
                    if (handle && handle.requestPermission) {
                        try { await handle.requestPermission({ mode: 'readwrite' }); }
                        catch (_) { /* el estado ya queda reflejado en createWritable */ }
                    }
                };
                const escribir = async () => {
                    writable = await handle.createWritable();
                    await writable.write(new Blob([bytes], { type: mime }));
                    await writable.close();
                    writable = null;
                    sessionStorage.removeItem('guarino_save_picker_bloqueado');
                    return 'guardado';
                };
                try {
                    handle = await window.showSaveFilePicker({
                        suggestedName: fileName,
                        types: ext ? [{ accept: { [mimeBase]: [ext] } }] : undefined
                    });
                    await pedirPermiso();
                    return await escribir();
                } catch (err) {
                    const ms = Math.round(ahora() - t0);
                    const esAbort = !!(err && err.name === 'AbortError');
                    // Cierra/aborta el writable sin commitear para no dejar parciales.
                    if (writable) {
                        try { await writable.abort(); } catch (_) { /* ya cerrado */ }
                        writable = null;
                    }
                    // Cancelación real del usuario: el diálogo se mostró y él lo cerró.
                    if (esAbort && ms >= 700) return 'cancelado';

                    // Escritura bloqueada por el contexto (NotAllowedError o
                    // SecurityError): pide permiso y reintenta UNA vez.
                    if (handle && err && (err.name === 'NotAllowedError' || err.name === 'SecurityError')) {
                        try {
                            await pedirPermiso();
                            return await escribir();
                        } catch (err2) {
                            console.warn('[saveAsFromBase64]', fileName,
                                '→ reintento de escritura falló (' + (err2 && err2.name) + ': ' +
                                (err2 && err2.message) + ').');
                        }
                        // Persistente en esta pestaña: no repetir el diálogo (litter de0 bytes).
                        sessionStorage.setItem('guarino_save_picker_bloqueado', String(Date.now()));
                    }
                    console.warn('[saveAsFromBase64]', fileName,
                        '→ picker path falló (' + (err && err.name) + ': ' + (err && err.message) +
                        ') tras ' + ms + ' ms; se usa descarga automática.');
                    // Cualquier otro error: cae a la descarga automática de abajo.
                }
            }

            const blob = new Blob([bytes], { type: mime });
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            // Diferido para no cortar la descarga que recién se disparó.
            setTimeout(function () {
                try { window.URL.revokeObjectURL(url); } catch (_) { /* ok */ }
            }, 60000);
            return 'descargado';
        };
    </script>

</body>

</html>
