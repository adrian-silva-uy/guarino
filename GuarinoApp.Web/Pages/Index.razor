@page "/"
@attribute [Authorize(Roles = RoleNames.TodosAutorizacion)]
@using MudBlazor

<div class="d-flex flex-column gap-2 mb-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">
        Sistema de Gestión Citrícola
    </MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary">
        Panel central de operaciones, control de stock, empaque y gerencia.
    </MudText>
</div>

<!-- KPIs Rápidos Globales -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2" Style="border-top: 4px solid var(--mud-palette-primary);">
            <MudCardContent>
                <MudText Typo="Typo.button" Class="mud-text-secondary">Dashboard Ejecutivo</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/dashboard" Class="mt-2 p-0" StartIcon="@Icons.Material.Filled.ArrowForward">Ver indicadores</MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2" Style="border-top: 4px solid var(--mud-palette-success);">
            <MudCardContent>
                <MudText Typo="Typo.button" Class="mud-text-secondary">Control de Stock</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Success" Href="/stockgeneral" Class="mt-2 p-0" StartIcon="@Icons.Material.Filled.ArrowForward">Ver stock general</MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2" Style="border-top: 4px solid var(--mud-palette-warning);">
            <MudCardContent>
                <MudText Typo="Typo.button" Class="mud-text-secondary">Asistente IA</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/iachat" Class="mt-2 p-0" StartIcon="@Icons.Material.Filled.AutoAwesome">Consultar al chat</MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudDivider Class="mb-6" />

<MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">Módulos del Sistema</MudText>

<!-- Accesos directos agrupados lógicamente -->
<MudGrid>
    <!-- 1. Gerencia y Proyecciones -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="h-100">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Gerencia y Proyecciones</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex flex-column gap-1">
                    <EnlaceSeguro Href="/dashboard">Dashboard Ejecutivo</EnlaceSeguro>
                    <EnlaceSeguro Href="/gerencia">Panel de Gerencia</EnlaceSeguro>
                    <EnlaceSeguro Href="/proyeccion-volcados">Proyección de Volcados</EnlaceSeguro>
                    <EnlaceSeguro Href="/proyeccion-zafra">Proyección de Zafra Siguiente</EnlaceSeguro>
                    <EnlaceSeguro Href="/resumenmensual">Resumen Mensual</EnlaceSeguro>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- 2. Operaciones y Planta -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="h-100">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Agriculture" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Planta y Operaciones</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex flex-column gap-1">
                    <EnlaceSeguro Href="/frutavolcar">Fruta a Volcar</EnlaceSeguro>
                    <EnlaceSeguro Href="/empaque">Gestión de Empaque</EnlaceSeguro>
                    <EnlaceSeguro Href="/basculas">Básculas</EnlaceSeguro>
                    <EnlaceSeguro Href="/registropesadas">Registro de Pesadas</EnlaceSeguro>
                    <EnlaceSeguro Href="/camioneszorras">Camiones y Zorras</EnlaceSeguro>
                    <EnlaceSeguro Href="/graficaprocesos">Gráfica de Procesos</EnlaceSeguro>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- 3. Stock y Pallets -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="h-100">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Stock y Pallets</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex flex-column gap-1">
                    <EnlaceSeguro Href="/stockgeneral">Stock General</EnlaceSeguro>
                    <EnlaceSeguro Href="/stockplaya">Stock en Playa</EnlaceSeguro>
                    <EnlaceSeguro Href="/pallets-definitivos">Pallets Definitivos</EnlaceSeguro>
                    <EnlaceSeguro Href="/palletssincliente">Pallets Sin Clientes</EnlaceSeguro>
                    <EnlaceSeguro Href="/palletscontramarca">Pallets por Contramarca</EnlaceSeguro>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
