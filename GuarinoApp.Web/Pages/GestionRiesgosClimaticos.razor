@page "/gestion-riesgos-climaticos"
@attribute [Authorize(Roles = "Admin, Gerencia, Contador, Operador")]
@using GuarinoApp.Application.Modules.ClimateRisk.Dtos
@using GuarinoApp.Application.Modules.ClimateRisk.Queries
@using GuarinoApp.Application.Modules.ClimateRisk.Commands
@using MediatR
@using Microsoft.JSInterop
@using MudBlazor
@implements IAsyncDisposable

<PageTitle>Gestión de Riesgos Climáticos</PageTitle>

<style>
    /* Enlace bidireccional: las filas de las tablas llevan al lote en el mapa (clic)
       y el lote elegido en el mapa parpadea acá. */
    .mud-table-row { cursor: pointer; }
    tr.fila-lote-flash > td {
        animation: filaFlash 2.4s ease-out;
    }
    @@keyframes filaFlash {
        0%, 55% { background-color: rgba(255, 193, 7, .45); }
        100% { background-color: transparent; }
    }
    /* Botón «Ver en la tabla» dentro de los popups del mapa (Leaflet). */
    .btn-ver-filas {
        margin-top: 6px;
        padding: 3px 10px;
        font-size: 12px;
        cursor: pointer;
        border: 1px solid #1976d2;
        border-radius: 4px;
        background: #fff;
        color: #1976d2;
    }
    .btn-ver-filas:hover { background: #1976d2; color: #fff; }
</style>

<div class="container-fluid mt-4">
    <div class="mb-4">
        <h2>Gestión de Riesgos Climáticos</h2>
        <MudText Typo="Typo.body2" Class="mb-2">
            Monitoreo de eventos climáticos que pueden comprometer la calidad, el calibre o el volumen
            de fruta exportable a EEUU, Unión Europea y Brasil — tanto lo que ya ocurrió como lo pronosticado.
        </MudText>
        <div class="d-flex gap-2">
            <MudTooltip Text="Analiza el historial y el pronóstico a 7 días (heladas, lluvias, viento, calor) sobre los lotes con coordenadas.">
            <MudButton OnClick="EjecutarEscaneo" Disabled="@escaneando" Color="Color.Warning">
                @if (escaneando)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-1" />
                    <span>Escaneando...</span>
                }
                else
                {
                    <span>Ejecutar Escaneo</span>
                }
            </MudButton>
            </MudTooltip>
            <MudTooltip Text="Vuelve a cargar los lotes, los eventos climáticos y el mapa de riesgos.">
            <MudButton OnClick="CargarDatos" Disabled="@escaneando" Color="Color.Primary">
                Actualizar
            </MudButton>
            </MudTooltip>
        </div>
    </div>

    <MudCard Class="mb-4">
        <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Mapa de Lotes</MudText></CardHeaderContent></MudCardHeader>
        <MudCardContent>
            <div id="mapa-riesgos-climaticos" style="height:420px; width:100%; border-radius:8px; overflow:hidden;"></div>
            <MudText Typo="Typo.caption" Class="mt-2">
                🟢 Sin eventos (30 días + hoy/pronóstico) &nbsp;&nbsp; 🟡 Riesgo Alta &nbsp;&nbsp; 🔴 Riesgo Crítica
                @if (mapaMarcadores.Count > 0)
                {
                    <span> &nbsp;&nbsp;·&nbsp;&nbsp; @mapaMarcadores.Count lote(s) con coordenadas</span>
                }
                <span> &nbsp;&nbsp;·&nbsp;&nbsp; El popup de cada marcador detalla cuántos eventos ya ocurrieron y cuántos son de hoy/pronóstico</span>
            </MudText>
        </MudCardContent>
    </MudCard>

    @if (!cargado)
    {
        <MudCard>
            <MudCardContent>
                <MudProgressCircular Indeterminate="true" />
                <p>Cargando...</p>
            </MudCardContent>
        </MudCard>
    }
    else if (errorCarga != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            No se pudo calcular el resumen de riesgos climáticos: @errorCarga
            Reintentá con «Actualizar»; si persiste, contactá al administrador. El mapa
            puede mostrar lotes mientras el resumen no está disponible.
        </MudAlert>
    }
    else if (resumen == null)
    {
        <MudAlert Severity="Severity.Success">
            Sin exposición detectada a heladas, lluvias excesivas, viento fuerte o calor extremo: ni en el
            historial reciente ni en el pronóstico disponible (hasta 7 días hacia adelante).
        </MudAlert>
    }
    else
    {
        <div class="row mb-2">
            <div class="col-md-3">
                <MudCard><MudCardContent>
                    <MudText Typo="Typo.h6">@resumen.TotalEventosRecientes</MudText>
                    <MudTooltip Text="Eventos de los ÚLTIMOS 30 DÍAS que ya pasaron: de hace 30 días hasta ayer ( Fecha < hoy ). La fecha de cada evento es el día calendario en que se detectó la condición.">
                        <MudText Typo="Typo.caption">Ya ocurrieron (30 días, hasta ayer)</MudText>
                    </MudTooltip>
                </MudCardContent></MudCard>
            </div>
            <div class="col-md-3">
                <MudCard><MudCardContent>
                    <MudText Typo="Typo.h6">@resumen.TotalEventosPronosticados</MudText>
                    <MudTooltip Text="Eventos de HOY (día en curso: el dato se confirma con el próximo escáner cada 6 h) más los de los próximos 7 días según el pronóstico de Open-Meteo. Están en la tabla «De Hoy y Riesgo Pronosticado», más abajo.">
                        <MudText Typo="Typo.caption">De hoy + pronosticados (7 días)</MudText>
                    </MudTooltip>
                </MudCardContent></MudCard>
            </div>
            <div class="col-md-3">
                <MudCard><MudCardContent>
                    <MudText Typo="Typo.h6">@resumen.LotesAfectados</MudText>
                    <MudTooltip Text="Lotes con al menos un evento en la ventana analizada (30 días + hoy/pronóstico).">
                        <MudText Typo="Typo.caption">Lotes con eventos</MudText>
                    </MudTooltip>
                </MudCardContent></MudCard>
            </div>
            <div class="col-md-3">
                <MudCard><MudCardContent>
                    <MudText Typo="Typo.h6">@resumen.ProductoresAfectados</MudText>
                    <MudTooltip Text="Productores con al menos un lote con eventos en la ventana analizada.">
                        <MudText Typo="Typo.caption">Productores afectados</MudText>
                    </MudTooltip>
                </MudCardContent></MudCard>
            </div>
        </div>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            <strong>¿Qué es un evento?</strong> Cada evento es <strong>un lote × un día × un tipo de condición</strong>
            climática que superó el umbral configurado (helada, lluvia excesiva, viento fuerte, calor extremo o granizo),
            medido con datos de Open-Meteo sobre las coordenadas del lote y actualizado cada 6 horas. Por eso un mismo
            lote puede acumular varios eventos en un mismo día. La severidad y el % de pérdida son
            <em>estimaciones</em> calculadas por umbrales, no mediciones de campo.
            <strong>Clic en una fila</strong> de las tablas para ver su lote en el mapa; en el popup de un marcador,
            <strong>«↗ Ver en la tabla»</strong> filtra la tabla por ese lote y te lleva a sus filas (quitás el filtro
            con la etiqueta «Filtrado: …» o el buscador de la tabla).
        </MudText>

        <!-- KPIs Financieros Detallados -->
        <MudCard Class="mb-4" Outlined="true" Style="border-left: 4px solid var(--mud-palette-primary);">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">💰 Impacto Financiero Estimado</MudText>
                    <MudText Typo="Typo.caption">Estimaciones por umbrales configurados — no son mediciones de campo</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTooltip Text="Kilos estimados dañados por TODOS los eventos de la ventana (ya ocurridos + hoy/pronóstico): % de daño estimado del evento × kilos netos del lote.">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Kilos Afectados (estimados)</MudText>
                        </MudTooltip>
                        <MudText Typo="Typo.h5" Class="fw-bold text-danger">
                            @resumen.KilosPerdidosTotales.ToString("N0") kg
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTooltip Text="@($"Kilos afectados ÷ kilos netos de los lotes con eventos en la ventana ({resumen.KilosLotesAfectados:N0} kg) × 100.")">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">% Pérdida (s/ kilos de lotes)</MudText>
                        </MudTooltip>
                        <MudText Typo="Typo.h5" Class="fw-bold text-warning">
                            @(resumen.PorcentajePerdidaTotal > 0 ? $"{resumen.PorcentajePerdidaTotal:0.##}%" : "N/D")
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTooltip Text="Kilos afectados correspondientes a eventos de HOY y de los próximos 7 días: todavía se pueden evitar o reducir con acciones preventivas.">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Kilos en Riesgo (hoy + pronóstico)</MudText>
                        </MudTooltip>
                        <MudText Typo="Typo.h5" Class="fw-bold text-info">
                            @resumen.KilosEnRiesgoPronosticado.ToString("N0") kg
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Tipo Más Frecuente</MudText>
                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @resumen.TipoEventoMasFrecuente
                        </MudText>
                    </MudItem>
                </MudGrid>
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2" Color="Color.Tertiary">
                    <strong>Cómo se calcula:</strong> @resumen.Observaciones
                </MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Class="mb-4">
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Resumen por Severidad y Tipo</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-1">Por severidad</MudText>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var kv in resumen.EventosPorSeveridad)
                    {
                        <MudChip T="string" Color="@ColorSeveridad(kv.Key)">@kv.Key: @kv.Value</MudChip>
                    }
                </div>
                <MudText Typo="Typo.subtitle2" Class="mb-1">Por tipo de evento</MudText>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var kv in resumen.EventosPorTipo)
                    {
                        <MudChip T="string" Color="Color.Default">@kv.Key: @kv.Value</MudChip>
                    }
                </div>
            </MudCardContent>
        </MudCard>

        @if (resumen.EventosPronosticados.Any())
        {
            <MudCard Class="mb-4" Outlined="true" Style="border-left: 4px solid var(--mud-palette-warning);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">🔮 De Hoy y Riesgo Pronosticado — Ventana Preventiva</MudText>
                        <MudText Typo="Typo.caption">
                            Incluye los eventos de <strong>HOY</strong> (día en curso: el dato se confirma con el próximo
                            escáner cada 6 h) y los pronosticados para los próximos 7 días según Open-Meteo.
                            Todavía no pasaron del todo: es la ventana para actuar antes de que impacten la fruta exportable.
                            Clic en una fila para ver el lote en el mapa. La tabla no pagina: lista todos los eventos
                            del filtro (hasta 500) y se filtra por lote o productor con el buscador (así también llega
                            «↗ Ver en la tabla» del mapa); los KPIs siempre cuentan el total exacto.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="@EventosPronosticadosVisibles" Hover="true" Dense="true"
                              T="EventoClimaticoDto">
                        <ToolBarContent>
                            @* Input nativo de Blazor (no MudTextField): @bind sincroniza
                                garantizadamente en AMBOS sentidos — el usuario filtra al
                                escribir (oninput) y el chip «Filtrado» limpia la caja al
                                limpiar el campo; el JS del mapa setea el valor y dispara
                                input/change para aplicar el filtro del botón del popup. *@
                            <input id="buscar-pronostico" class="form-control form-control-sm"
                                   style="max-width:280px;"
                                   placeholder="Buscar lote o productor…"
                                   @bind="_filtroPronostico" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_filtroPronostico))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ms-2"
                                         OnClick="LimpiarFiltroPronostico">
                                    Filtrado: @_filtroPronostico — clic para quitar
                                </MudChip>
                            }
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Fecha (hoy/pronóstico)</MudTh>
                            <MudTh>Lote</MudTh>
                            <MudTh>Productor</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Severidad</MudTh>
                            <MudTh>% Pérdida Estimada</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@(context.Fecha.Date == DateTime.Today ? "Hoy " + context.Fecha.ToString("dd/MM") : context.Fecha.ToString("dd/MM"))</MudTd>
                            <MudTd>@context.LoteNombre</MudTd>
                            <MudTd>@context.ProductorNombre</MudTd>
                            <MudTd>@context.TipoEvento</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@ColorSeveridad(context.SeveridadEstimada)">
                                    @context.SeveridadEstimada
                                </MudChip>
                            </MudTd>
                            <MudTd>@(context.PorcentajePerdidaEstimada?.ToString("0.##") ?? "N/D")%</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }

        @if (resumen.EventosRecientes.Any())
        {
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">🕐 Impacto Ya Ocurrido — Días Anteriores</MudText>
                        <MudText Typo="Typo.caption">
                            Eventos confirmados en días anteriores de los últimos 30 días (la fecha es el día calendario
                            del evento). La severidad y el % de pérdida son estimaciones por umbrales configurados.
                            Clic en una fila para ver el lote en el mapa. La tabla no pagina: lista todos los eventos
                            del filtro (hasta 500) y se filtra por lote o productor con el buscador; los KPIs siempre
                            cuentan el total exacto.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="@EventosRecientesVisibles" Hover="true" Dense="true"
                              T="EventoClimaticoDto">
                        <ToolBarContent>
                            @* Input nativo de Blazor (ver nota en la tabla de pronóstico). *@
                            <input id="buscar-recientes" class="form-control form-control-sm"
                                   style="max-width:280px;"
                                   placeholder="Buscar lote o productor…"
                                   @bind="_filtroRecientes" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_filtroRecientes))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ms-2"
                                         OnClick="LimpiarFiltroRecientes">
                                    Filtrado: @_filtroRecientes — clic para quitar
                                </MudChip>
                            }
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Lote</MudTh>
                            <MudTh>Productor</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Severidad</MudTh>
                            <MudTh>% Pérdida Estimada</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Fecha.ToString("dd/MM")</MudTd>
                            <MudTd>@context.LoteNombre</MudTd>
                            <MudTd>@context.ProductorNombre</MudTd>
                            <MudTd>@context.TipoEvento</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@ColorSeveridad(context.SeveridadEstimada)">
                                    @context.SeveridadEstimada
                                </MudChip>
                            </MudTd>
                            <MudTd>@(context.PorcentajePerdidaEstimada?.ToString("0.##") ?? "N/D")%</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }

        <MudCard>
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Plan de Mitigación</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                @if (generandoPlan)
                {
                    <MudProgressCircular Indeterminate="true" />
                    <MudText Typo="Typo.caption" Class="ms-2">Generando recomendaciones...</MudText>
                }
                else if (resumen.PlanMitigacion?.Any() == true)
                {
                    <div class="row">
                        @foreach (var plan in resumen.PlanMitigacion)
                        {
                            <div class="col-md-6 mb-3">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2">@plan.Texto</MudText>
                                        <div class="d-flex align-center mt-2 flex-wrap">
                                            <MudText Typo="Typo.caption"><strong>@plan.Categoria</strong></MudText>
                                            <MudTooltip Text="@TextoOrigen(plan.Origen)" Placement="Placement.Top" Arrow="true">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ColorOrigen(plan.Origen)" Class="ms-2">@plan.Origen</MudChip>
                                            </MudTooltip>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2">Sin recomendaciones disponibles todavía.</MudText>
                }
                <MudButton OnClick="RegenerarPlan" Color="Color.Success" Disabled="@generandoPlan">Regenerar</MudButton>
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    private bool cargado = false;
    private bool escaneando = false;
    private bool generandoPlan = false;
    private ClimateRiskSummaryDto? resumen;
    private List<ClimateMapMarkerDto> mapaMarcadores = new();
    private string? errorCarga;

    private IJSObjectReference? _mapModule;
    private bool _mapInicializado = false;

    // Filtros de búsqueda de las dos tablas. Se escriben desde el buscador de la
    // tabla o desde el botón «↗ Ver en la tabla» del mapa (climateMap.js fija el
    // valor del input y dispara el evento input → @bind-Value los aplica, todo en
    // el cliente, sin DotNetObjectReference). Así cualquier lote con eventos tiene
    // sus filas a la vista al instante, sin recorrer la lista completa.
    private string _filtroPronostico = string.Empty;
    private string _filtroRecientes = string.Empty;

    private IEnumerable<EventoClimaticoDto> EventosPronosticadosVisibles =>
        resumen?.EventosPronosticados.Where(e => CoincideFiltro(e, _filtroPronostico)) ?? [];

    private IEnumerable<EventoClimaticoDto> EventosRecientesVisibles =>
        resumen?.EventosRecientes.Where(e => CoincideFiltro(e, _filtroRecientes)) ?? [];

    private static bool CoincideFiltro(EventoClimaticoDto ev, string filtro) =>
        string.IsNullOrWhiteSpace(filtro)
        || (ev.LoteNombre?.Contains(filtro, StringComparison.OrdinalIgnoreCase) ?? false)
        || (ev.ProductorNombre?.Contains(filtro, StringComparison.OrdinalIgnoreCase) ?? false);

    private void LimpiarFiltroPronostico() => _filtroPronostico = string.Empty;

    private void LimpiarFiltroRecientes() => _filtroRecientes = string.Empty;

    [Inject] private IMediator Mediator { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await CargarDatos();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _mapModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/climateMap.js");
                await _mapModule.InvokeVoidAsync("initMap", "mapa-riesgos-climaticos", mapaMarcadores);
                _mapInicializado = true;
                // Cierra la carrera: si los marcadores llegaron ANTES de que el módulo
                // JS terminara de cargar Leaflet, initMap los dibujó vacíos; acá se
                // vuelven a setear con los datos ya disponibles.
                if (mapaMarcadores.Count > 0)
                {
                    await _mapModule.InvokeVoidAsync("setMarkers", mapaMarcadores);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"No se pudo cargar el mapa: {ex.Message}", Severity.Warning);
            }
        }
    }

    private async Task CargarDatos()
    {
        cargado = false;
        errorCarga = null;
        StateHasChanged();

        try
        {
            mapaMarcadores = await Mediator.Send(new GetClimateMapMarkersQuery());
            if (_mapInicializado && _mapModule != null)
            {
                await _mapModule.InvokeVoidAsync("setMarkers", mapaMarcadores);
            }

            resumen = await Mediator.Send(new GetClimateRiskSummaryQuery());
            cargado = true;
            StateHasChanged();

            if (resumen != null)
            {
                await GenerarPlan();
            }
        }
        catch (Exception ex)
        {
            // Un error de carga NUNCA se muestra como "Sin exposición detectada":
            // la alerta de éxito solo corresponde cuando la consulta respondió 0 eventos.
            errorCarga = ex.Message;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            cargado = true;
        }
    }

    private async Task EjecutarEscaneo()
    {
        escaneando = true;
        StateHasChanged();
        try
        {
            await Mediator.Send(new EjecutarEscaneoClimaticoCommand());
            Snackbar.Add("✓ Escaneo completado", Severity.Success);
            await CargarDatos();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            escaneando = false;
            StateHasChanged();
        }
    }

    private async Task GenerarPlan()
    {
        if (resumen == null || resumen.Eventos.Count == 0) return;

        generandoPlan = true;
        StateHasChanged();

        try
        {
            resumen.PlanMitigacion = await Mediator.Send(new GenerarPlanMitigacionCommand(resumen.Eventos));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo generar el plan de mitigación: {ex.Message}", Severity.Warning);
        }
        finally
        {
            generandoPlan = false;
            StateHasChanged();
        }
    }

    private async Task RegenerarPlan() => await GenerarPlan();

    private static Color ColorSeveridad(string severidad) => severidad switch
    {
        "Crítica" => Color.Error,
        "Alta" => Color.Warning,
        _ => Color.Default
    };

    /// <summary>Color del chip de origen de cada acción: verde para lo calculado
    /// con datos reales, neutro para la recomendación estándar.</summary>
    private static Color ColorOrigen(string? origen) =>
        string.Equals(origen, "Calculado", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Default;

    /// <summary>Explicación del origen de cada acción, en lenguaje que entienda
    /// el usuario final (sin tecnicismos internos).</summary>
    private static string TextoOrigen(string? origen)
    {
        if (string.Equals(origen, "Calculado", StringComparison.OrdinalIgnoreCase))
            return "La acción está respaldada por tus datos reales: se calculó a partir de un patrón de tu propia información (historial de eventos climáticos, kilos perdidos, costos). Es una recomendación anclada en lo que pasó en tu operación.";
        if (string.Equals(origen, "Checklist", StringComparison.OrdinalIgnoreCase))
            return "Recomendación operativa estándar (buena práctica o sentido común agronómico) sin un dato numérico real detrás: es conocimiento general de la materia, no algo calculado con tus cifras.";
        return "Origen de la recomendación.";
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapModule != null)
        {
            try { await _mapModule.InvokeVoidAsync("dispose"); } catch { }
            try { await _mapModule.DisposeAsync(); } catch { }
        }
    }
}
