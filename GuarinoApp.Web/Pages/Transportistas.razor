@page "/transportistas"
@attribute [Authorize(Roles = RoleNames.TodosAutorizacion)]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Modules.Transportistas.Queries.GetTransportistas
@using GuarinoApp.Application.Modules.Transportistas.Dtos
@inject IMediator Mediator

<MudText Typo="Typo.h4" GutterBottom="true">🚛 Transportistas</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Listado de Transportistas</MudText>

<MudCard>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTooltip Text="Recarga la lista de transportistas registrados.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData" Disabled="@_loading" FullWidth="true">
                    @(_loading ? "Cargando..." : "Actualizar")
                </MudButton>
                </MudTooltip>
            </MudItem>
        </MudGrid>

        @if (_data.Any())
        {
            <MudTable RowsPerPage="25" Items="@_data" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    @foreach (var prop in typeof(TransportistaDto).GetProperties())
                    {
                        <MudTh>@prop.Name</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    @foreach (var prop in typeof(TransportistaDto).GetProperties())
                    {
                        var value = prop.GetValue(context);
                        <MudTd>@value</MudTd>
                    }
                </RowTemplate>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25 }" RowsPerPageString="Filas por página:" InfoFormat="Mostrando {first_item}–{last_item} de {all_items} registros" />
            </PagerContent>
            </MudTable>

            <DataSourceFooter EsDummy="false" Origen="Base de datos DTrace" FechaActualizacion="@DateTime.Now" TotalRegistros="@_data.Count" />
        }
        else if (!_loading && _cargado)
        {
            <MudAlert Severity="Severity.Info">No se encontraron registros.</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<TransportistaDto> _data = new();
    private bool _loading = false;
    private bool _cargado = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _loading = true;
        _cargado = false;
        try
        {
            _data = await Mediator.Send(new GetTransportistasQuery());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            _cargado = true;
            StateHasChanged();
        }
    }
}
