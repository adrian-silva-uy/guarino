@page "/wiki"
@attribute [Authorize(Roles = RoleNames.TodosAutorizacion)]
@using Markdig
@using System.IO
@inject IWebHostEnvironment Env

<MudText Typo="Typo.h4" GutterBottom="true">Manual de usuario</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Guia funcional de GuarinoApp: selecciona un tema del indice para ver su contenido.</MudText>

<style>
    .wiki-content {
        overflow-x: hidden;
        max-width: 100%;
    }
    .wiki-content img {
        max-width: 100% !important;
        width: auto !important;
        height: auto !important;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        margin: 12px 0;
        display: block;
    }
    .wiki-content h1, .wiki-content h2, .wiki-content h3 {
        margin-top: 16px;
        margin-bottom: 8px;
    }
    .wiki-content table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }
    .wiki-content table th, .wiki-content table td {
        border: 1px solid #ddd;
        padding: 8px;
        word-wrap: break-word;
    }
    .wiki-content pre {
        overflow-x: auto;
        max-width: 100%;
    }
    .wiki-content code {
        word-break: break-word;
    }
    @@media (max-width: 960px) {
        .wiki-index {
            position: static !important;
            max-height: none !important;
        }
    }
</style>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-3 wiki-index" Elevation="2" Style="position:sticky;top:16px;max-height:80vh;overflow-y:auto;">
            <MudText Typo="Typo.h6" Class="mb-2">Indice</MudText>
            <MudNavMenu Dense="true">
                @foreach (var sec in _secciones)
                {
                    <MudNavLink OnClick="@(() => MostrarSeccion(sec.Titulo))" Icon="@Icons.Material.Filled.ChevronRight"
                                Class="@(_seccionActual == sec.Titulo ? "mud-nav-link-active" : "")">
                        @sec.Titulo
                    </MudNavLink>
                }
            </MudNavMenu>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="9">
        <MudPaper Class="pa-4" Elevation="2">
            @if (_cargando)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else if (string.IsNullOrEmpty(_htmlSeccion))
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">Selecciona un tema del indice.</MudText>
            }
            else
            {
                <div class="wiki-content">
                    @((MarkupString)_htmlSeccion)
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private List<Seccion> _secciones = new();
    private string _seccionActual = string.Empty;
    private string _htmlSeccion = string.Empty;
    private bool _cargando = false;

    private class Seccion
    {
        public string Titulo { get; set; } = string.Empty;
        public string Contenido { get; set; } = string.Empty;
    }

    private bool _inicializado = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_inicializado)
        {
            _inicializado = true;
            await CargarDocumentoAsync("WIKI_USUARIO.md");
        }
    }

    private async Task CargarDocumentoAsync(string nombre)
    {
        _cargando = true;
        StateHasChanged();

        try
        {
            var path = Path.Combine(Env.WebRootPath, "wiki", nombre);
            if (!File.Exists(path))
            {
                _htmlSeccion = "<p>Archivo no encontrado.</p>";
                return;
            }

            var md = await File.ReadAllTextAsync(path);
            _secciones = ParsearSecciones(md);

            // Mostrar la primera seccion con contenido
            var primeraConContenido = _secciones.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.Contenido));
            if (primeraConContenido != null)
            {
                await MostrarSeccion(primeraConContenido.Titulo);
            }
            else if (_secciones.Count > 0)
            {
                await MostrarSeccion(_secciones[0].Titulo);
            }
        }
        catch (Exception ex)
        {
            _htmlSeccion = "<p>Error al cargar: " + ex.Message + "</p>";
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private List<Seccion> ParsearSecciones(string md)
    {
        var secciones = new List<Seccion>();
        var lines = md.Split('\n');
        var tituloActual = string.Empty;
        var contenidoActual = new System.Text.StringBuilder();

        foreach (var line in lines)
        {
            // Detectar encabezados de nivel 2 (##) o nivel 3 (###) como secciones
            if (line.StartsWith("## ") || line.StartsWith("### "))
            {
                // Guardar la seccion anterior si tiene contenido
                if (!string.IsNullOrEmpty(tituloActual) && contenidoActual.Length > 0)
                {
                    secciones.Add(new Seccion { Titulo = tituloActual, Contenido = contenidoActual.ToString().Trim() });
                }
                // Nuevo titulo (sin los #)
                tituloActual = line.TrimStart('#').Trim();
                contenidoActual.Clear();
            }
            else
            {
                contenidoActual.AppendLine(line);
            }
        }
        // Guardar la ultima seccion
        if (!string.IsNullOrEmpty(tituloActual) && contenidoActual.Length > 0)
        {
            secciones.Add(new Seccion { Titulo = tituloActual, Contenido = contenidoActual.ToString().Trim() });
        }

        // Si no se encontraron secciones (sin encabezados ##), mostrar todo como una seccion
        if (secciones.Count == 0)
        {
            secciones.Add(new Seccion { Titulo = "Contenido", Contenido = md });
        }

        return secciones;
    }

    private Task MostrarSeccion(string titulo)
    {
        _seccionActual = titulo;
        var sec = _secciones.FirstOrDefault(s => s.Titulo == titulo);
        if (sec != null)
        {
            _htmlSeccion = Markdown.ToHtml(sec.Contenido, _pipeline);
        }
        else
        {
            _htmlSeccion = string.Empty;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }
}