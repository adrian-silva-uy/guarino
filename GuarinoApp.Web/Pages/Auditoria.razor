@page "/auditoria"
@attribute [Authorize(Roles = "Admin, Gerencia")]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Common.Interfaces
@using GuarinoApp.Application.Modules.Auditoria.Queries.GetLogs
@using GuarinoApp.Application.Modules.Auditoria.Dtos
@using GuarinoApp.Application.Modules.Auth.Queries.GetUsers
@using GuarinoApp.Application.Modules.Auth.Dtos
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<Auditoria> Logger

<PageTitle>Auditoría - Logs del Sistema</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark">📋 Auditoría del Sistema</h2>
            <p class="text-muted mb-0">Registro de actividad de usuarios - Quién, cuándo y qué hizo</p>
        </div>
        <MudTooltip Text="Vuelve a leer los logs del servidor (muestra los últimos movimientos).">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarLogs" StartIcon="@Icons.Material.Filled.Refresh">
                Actualizar
            </MudButton>
        </MudTooltip>
    </div>

    <!-- Filtros -->
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Filtros de Búsqueda</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker Label="Fecha Desde" Date="_fechaDesde" DateChanged="OnFechaDesdeChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   HelperText="Muestra logs desde esta fecha (inclusive)." />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker Label="Fecha Hasta" Date="_fechaHasta" DateChanged="OnFechaHastaChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   HelperText="Muestra logs hasta esta fecha (inclusive)." />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    @* Allowlist: se elige entre los usuarios existentes de la
                       app, no texto libre. Sentinel "__todos__" = filtro vacío:
                       con value vacío ("") MudBlazor no izaba el label y el
                       texto "Todos los usuarios" quedaba solapado con "Usuario". *@
                    <MudSelect T="string"
                               @bind-Value="_userName"
                               Label="Usuario"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               HelperText="Quién ejecutó la acción (lista de usuarios)."
                               Clearable="true">
                        <MudSelectItem Value="@TodosUsuarios">Todos los usuarios</MudSelectItem>
                        @foreach (var u in _usuarios)
                        {
                            <MudSelectItem Value="@u.UserName">@u.UserName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_action" Label="Acción" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  HelperText="Texto parcial: Create, Update, Delete, Login, Consulta, Importar..." />
                </MudItem>
            </MudGrid>
            <div class="d-flex justify-content-end mt-3">
                <MudTooltip Text="Quita todos los filtros y muestra todos los logs.">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="LimpiarFiltros" Class="me-2">
                        Limpiar
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Aplica los filtros elegidos (fechas, usuario y acción).">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarLogs">
                        Buscar
                    </MudButton>
                </MudTooltip>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Tabla de Logs: server-side sin paginar, carga todos los registros del filtro de una vez (misma conducta que Stock General) -->
    <MudCard Elevation="1">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">
                Registros (@_total total)
            </MudText>
            <MudTable @ref="_table"
                      T="LogDto"
                      ServerData="@ServerReload"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Fecha/Hora</MudTh>
                    <MudTh>Usuario</MudTh>
                    <MudTh>Rol</MudTh>
                    <MudTh>Acción</MudTh>
                    <MudTh>Módulo</MudTh>
                    <MudTh>Descripción</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fecha/Hora">@context.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Usuario">
                        <MudText Typo="Typo.body2" Class="fw-bold">@context.UserName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Rol">
                        <MudChip Size="Size.Small" Color="@GetRoleColor(context.Role)">@context.Role</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Acción">
                        <MudChip Size="Size.Small" Color="@GetActionColor(context.Action)">@context.Action</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Módulo">@context.Module</MudTd>
                    <MudTd DataLabel="Descripción">
                        <MudText Typo="Typo.body2">@context.Description</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info">No se encontraron registros con los filtros seleccionados.</MudAlert>
                </NoRecordsContent>
                <LoadingContent>
                    <div class="d-flex justify-content-center py-4">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    </div>
                </LoadingContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private MudTable<LogDto>? _table;
    private int _total = 0;
    private bool _usuariosCargados;
    private bool _reintentoHecho;

    private DateTime? _fechaDesde = null;
    private DateTime? _fechaHasta = null;

    /// <summary>Sentinel del filtro "Todos los usuarios". No se usa string.Empty
    /// porque MudBlazor no izaba el label con valor vacío y el texto del ítem
    /// quedaba solapado con el label "Usuario".</summary>
    private const string TodosUsuarios = "__todos__";
    private string _userName = TodosUsuarios;
    private string? _action = null;
    private List<AppUserDto> _usuarios = new();

    protected override Task OnInitializedAsync()
    {
        // Los usuarios del filtro NO se cargan acá: al primer await Blazor hace
        // el primer render y MudTable dispara ServerReload en paralelo, y las dos
        // queries corrían a la vez sobre el MISMO DbContext escopado ("A second
        // operation was started on this context instance"). Se cargan serializados
        // al final de la primera ServerReload (ver flag _usuariosCargados).
        return Task.CompletedTask;
    }

    /// <summary>Carga los usuarios existentes para el filtro desplegable
    /// (si falla, el filtro queda sin opciones pero la auditoría sigue
    /// funcionando). Debe correr DESPUÉS de que termine la query de la tabla
    /// para no solaparse en el DbContext escopado.</summary>
    private async Task CargarUsuarios()
    {
        try
        {
            _usuarios = await Mediator.Send(new GetUsersQuery());
        }
        catch (ObjectDisposedException)
        {
            // Circuito cerrado durante la carga del filtro (ver nota en ServerReload).
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar usuarios para el filtro de auditoría");
        }
    }

    /// <summary>Carga server-side sin paginar (misma conducta que Stock General):
    /// ignora la página/PageSize que manda la tabla (ya no hay MudTablePager) y pide
    /// TODOS los registros del filtro de una sola vez (PageSize = int.MaxValue →
    /// Skip/Take en el handler). Devuelve también el total para el título
    /// "Registros (N total)".</summary>
    private async Task<TableData<LogDto>> ServerReload(TableState state)
    {
        try
        {
            var query = new GetLogsQuery(
                FechaDesde: _fechaDesde,
                FechaHasta: _fechaHasta,
                UserName: EsFiltroTodosUsuarios() ? null : _userName,
                Action: _action,
                Page: 1,
                PageSize: int.MaxValue
            );

            var result = await Mediator.Send(query);
            _total = result.TotalCount;
            if (!_usuariosCargados)
            {
                // Serializado con la query de la tabla (mismo DbContext escopado:
                // acá la anterior YA terminó).
                _usuariosCargados = true;
                await CargarUsuarios();
            }
            _reintentoHecho = false;
            StateHasChanged();
            return new TableData<LogDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (ObjectDisposedException)
        {
            // El circuito se cerró (navegación o cierre de pestaña) con la carga
            // en vuelo: el scope ya está dispuesto, no hay nada que mostrar ni
            // registrar. No es un error de la aplicación — antes generaba ruido
            // en el log y el reporte diario por correo al administrador.
            return new TableData<LogDto>
            {
                Items = Array.Empty<LogDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar logs de auditoría");
            Snackbar.Add("Error al cargar los registros", Severity.Error);
            _total = 0;
            if (!_usuariosCargados)
            {
                _usuariosCargados = true;
                await CargarUsuarios();
            }
            StateHasChanged();
            // Un solo reintento automático ante una carrera transitoria de DbContext.
            if (!_reintentoHecho)
            {
                _reintentoHecho = true;
                _ = InvokeAsync(async () =>
                {
                    await Task.Delay(700);
                    await CargarLogs();
                });
            }
            return new TableData<LogDto>
            {
                Items = Array.Empty<LogDto>(),
                TotalItems = 0
            };
        }
    }

    private bool EsFiltroTodosUsuarios() =>
        _userName is null || _userName == TodosUsuarios || string.IsNullOrWhiteSpace(_userName);

    private void OnFechaDesdeChanged(DateTime? date)
    {
        _fechaDesde = date;
    }

    private void OnFechaHastaChanged(DateTime? date)
    {
        _fechaHasta = date;
    }

    private async Task CargarLogs()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task LimpiarFiltros()
    {
        _fechaDesde = null;
        _fechaHasta = null;
        _userName = TodosUsuarios;
        _action = null;
        await CargarLogs();
    }

    private static Color GetRoleColor(string? role) => role switch
    {
        "Gerencia" => Color.Primary,
        "Admin" => Color.Error,
        "Contador" => Color.Success,
        "Operador" => Color.Warning,
        _ => Color.Default
    };

    private static Color GetActionColor(string action) => action switch
    {
        "Create" => Color.Success,
        "Update" => Color.Warning,
        "Delete" => Color.Error,
        "Export" => Color.Info,
        "View" => Color.Default,
        _ => Color.Default
    };
}
