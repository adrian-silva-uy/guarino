@page "/gerencia"
@attribute [Authorize(Roles = "Admin, Gerencia")]
@using MediatR
@using MudBlazor
@using GuarinoApp.Application.Modules.Gerencia.Queries.GetIndicadoresGerencia
@using GuarinoApp.Application.Modules.Gerencia.Dtos
@inject IMediator Mediator

<MudText Typo="Typo.h4" GutterBottom="true">📊 Panel de Gerencia</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Indicadores clave de la operación</MudText>

<MudCard>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData" Disabled="@_loading" FullWidth="true">
                    @(_loading ? "Cargando..." : "Actualizar indicadores")
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_data.Any())
        {
            <MudGrid>
                @foreach (var group in _data.GroupBy(x => x.Categoria))
                {
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.h6" GutterBottom="true">@group.Key</MudText>
                        @foreach (var item in group)
                        {
                            <MudCard Class="mb-2" Elevation="0" Style="border-left: 4px solid #3d6fb0;">
                                <MudCardContent>
                                    <MudText Typo="Typo.body1">@item.Indicador</MudText>
                                    <MudText Typo="Typo.h5">@item.Valor.ToString("N0")</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Tertiary">@item.Fecha?.ToShortDateString()</MudText>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudItem>
                }
            </MudGrid>
        }
        else if (!_loading && _cargado)
        {
            <MudAlert Severity="Severity.Info">No se encontraron indicadores.</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<IndicadorGerenciaDto> _data = new();
    private bool _loading = false;
    private bool _cargado = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _loading = true;
        _cargado = false;
        try
        {
            _data = await Mediator.Send(new GetIndicadoresGerenciaQuery());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
            _cargado = true;
            StateHasChanged();
        }
    }
}
