# Obligatorio: normalizar como texto y preferir UTF-8 en el working tree
* text=auto

# Preferir UTF-8 para archivos de código y vistas
*.cs     text working-tree-encoding=UTF-8
*.razor  text working-tree-encoding=UTF-8
*.cshtml text working-tree-encoding=UTF-8
*.html   text working-tree-encoding=UTF-8
*.json   text working-tree-encoding=UTF-8
*.md     text working-tree-encoding=UTF-8
*.txt    text working-tree-encoding=UTF-8
